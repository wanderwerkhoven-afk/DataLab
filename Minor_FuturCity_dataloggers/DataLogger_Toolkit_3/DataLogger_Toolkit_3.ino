    right:12px;
    padding:8px 10px;
    font-size:10px;
  }

  .content{padding:12px}
  .homeactions{gap:10px}
  .action{
    min-height:112px;
    padding:13px 8px;
    border-radius:18px;
  }
  .action .bigicon{
    width:42px;
    height:42px;
  }
  .action .bigicon svg{
    width:25px;
    height:25px;
  }

  .sensor{
    min-height:126px;
  }
  .sensor.compact{
    min-height:116px;
  }
  .sensoricon .iconwrap{
    width:52px;
    height:52px;
    flex-basis:52px;
  }
  .sensorcontent{
    padding:13px 12px 13px 6px;
  }
  .sensor .value,
  .sensor.emphasis .value{
    font-size:18px;
  }
  .sensor.compact .value{
    font-size:16px;
  }

  .nav{
    min-height:70px;
    padding:6px 8px calc(10px + env(safe-area-inset-bottom));
  }
  .nav button{
    min-height:46px;
  }
  .navIconWrap,
  .nav button>span{
    width:36px;
    height:36px;
  }
  .navSvgIcon,
  .nav .playIconSvg{
    width:24px;
    height:24px;
  }
  .nav button .chartNavIcon{
    width:36px;
    height:36px;
