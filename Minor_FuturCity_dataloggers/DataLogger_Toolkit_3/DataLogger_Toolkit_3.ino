// ---------- Helpers ----------
String sessionPath(uint32_t id){ char b[32]; snprintf(b,sizeof(b),"%s/S%04lu.CSV",LOG_DIR,(unsigned long)id); return String(b); }
String twoDigits(int v){ return (v<10?"0":"")+String(v); }
String formatDateTime(const DateTime &dt){ return String(dt.year())+"-"+twoDigits(dt.month())+"-"+twoDigits(dt.day())+" "+twoDigits(dt.hour())+":"+twoDigits(dt.minute())+":"+twoDigits(dt.second()); }
String formatTimeOnly(const DateTime &dt){ return twoDigits(dt.hour())+":"+twoDigits(dt.minute())+":"+twoDigits(dt.second()); }
uint32_t elapsedSessionMs(){ if(sessionState==STATE_RUNNING) return accumulatedRunMs + (uint32_t)(millis()-runStartedMs); return accumulatedRunMs; }
const char* stateName(){ return sessionState==STATE_RUNNING?"running":sessionState==STATE_PAUSED?"paused":"idle"; }
bool validArduinoFix(){ return gps.location.isValid() && gps.location.age()<5000 && gps.satellites.isValid() && gps.satellites.value()>0; }
bool validGpsUtc(){ return gps.date.isValid() && gps.time.isValid() && gps.date.age()<5000 && gps.time.age()<5000 && gps.date.year()>=2024 && gps.date.year()<=2100; }

bool selectedPosition(double &lat,double &lon,const char* &source){
  if(validArduinoFix()){
    lat=gps.location.lat();
    lon=gps.location.lng();
    source="Air530Z";
    return true;
  }
  source="Geen";
  lat=0;
  lon=0;
  return false;
}

void readGps(){ while(Serial1.available()){ char c=(char)Serial1.read(); gps.encode(c); gpsSeen=true; } }
void readSensors(){
  if(shtReady){float t=sht31.readTemperature(),h=sht31.readHumidity();if(!isnan(t))liveTemp=t;if(!isnan(h))liveHum=h;}
  uint32_t sum=0;const uint8_t N=12;for(uint8_t i=0;i<N;i++){sum+=analogRead(WIND_PIN);delayMicroseconds(250);}float adc=sum/(float)N;liveWindVoltage=adc*5.0f/4095.0f;liveWind=liveWindVoltage*6.0f;if(liveWind<0)liveWind=0;if(liveWind>30)liveWind=30;lastSensorReadMs=millis();
}


uint32_t findNextSessionId(){
  uint32_t maxId=0;if(!sdReady)return 1;File dir=SD.open(LOG_DIR);if(!dir)return 1;
  for(File f=dir.openNextFile();f;f=dir.openNextFile()){
    if(!f.isDirectory()){String n=String(f.name());int p=n.lastIndexOf('/');if(p>=0)n=n.substring(p+1);
      if(n.startsWith("S")&&n.endsWith(".CSV")){uint32_t id=(uint32_t)n.substring(1,n.length()-4).toInt();if(id>maxId)maxId=id;}}
    f.close();
  }dir.close();return maxId+1;
}
bool ensureLogDir(){if(SD.exists(LOG_DIR))return true;return SD.mkdir(LOG_DIR);}
void writeCsvHeader(File &f){
  f.println("measurement_id,rtc_datetime_local,elapsed_ms,temperature_C,humidity_pct,wind_speed_ms,wind_voltage_V,latitude,longitude,satellites,gps_fix,gps_speed_kmh,gps_utc,location_source");
  f.flush();
}
bool startSession(){
  if(sessionState!=STATE_IDLE||!sdReady)return false;if(!ensureLogDir())return false;
  sessionId=findNextSessionId();String path=sessionPath(sessionId);sessionFile=SD.open(path.c_str(),FILE_WRITE);if(!sessionFile)return false;
  writeCsvHeader(sessionFile);measurementCount=0;accumulatedRunMs=0;runStartedMs=millis();lastMeasureMs=millis()-intervalMs;lastFlushMs=millis();sessionState=STATE_RUNNING;return true;
}
void pauseSession(){if(sessionState==STATE_RUNNING){accumulatedRunMs+=(uint32_t)(millis()-runStartedMs);sessionState=STATE_PAUSED;if(sessionFile)sessionFile.flush();}}
void resumeSession(){if(sessionState==STATE_PAUSED){runStartedMs=millis();lastMeasureMs=millis()-intervalMs;sessionState=STATE_RUNNING;}}
void stopSession(){if(sessionState==STATE_RUNNING)accumulatedRunMs+=(uint32_t)(millis()-runStartedMs);if(sessionFile){sessionFile.flush();sessionFile.close();}sessionState=STATE_IDLE;}

void logMeasurement(){
  if(sessionState!=STATE_RUNNING||!sessionFile)return;readSensors();DateTime now=rtcReady?rtc.now():DateTime(2000,1,1,0,0,0);
  double lat=0,lon=0;const char* locSource;bool hasPos=selectedPosition(lat,lon,locSource);bool gpsFix=validArduinoFix();measurementCount++;
  sessionFile.print(measurementCount);sessionFile.print(',');sessionFile.print(formatDateTime(now));sessionFile.print(',');sessionFile.print(elapsedSessionMs());sessionFile.print(',');
  if(isnan(liveTemp))sessionFile.print("");else sessionFile.print(liveTemp,2);sessionFile.print(',');
  if(isnan(liveHum))sessionFile.print("");else sessionFile.print(liveHum,2);sessionFile.print(',');
  if(isnan(liveWind))sessionFile.print("");else sessionFile.print(liveWind,2);sessionFile.print(',');
  if(isnan(liveWindVoltage))sessionFile.print("");else sessionFile.print(liveWindVoltage,3);sessionFile.print(',');
  if(hasPos){sessionFile.print(lat,6);sessionFile.print(',');sessionFile.print(lon,6);}sessionFile.print(',');
  sessionFile.print(gps.satellites.isValid()?gps.satellites.value():0);sessionFile.print(',');sessionFile.print(gpsFix?1:0);sessionFile.print(',');
  if(gps.speed.isValid())sessionFile.print(gps.speed.kmph(),2);sessionFile.print(',');
  if(validGpsUtc()){char utc[24];snprintf(utc,sizeof(utc),"%04d-%02d-%02d %02d:%02d:%02d",gps.date.year(),gps.date.month(),gps.date.day(),gps.time.hour(),gps.time.minute(),gps.time.second());sessionFile.print(utc);}
  sessionFile.print(',');sessionFile.println(locSource);
  if((uint32_t)(millis()-lastFlushMs)>=1000){sessionFile.flush();lastFlushMs=millis();}
}

String queryValue(const String &url,const String &key){int q=url.indexOf('?');if(q<0)return "";String qs=url.substring(q+1),needle=key+"=";int p=0;while(p<qs.length()){int amp=qs.indexOf('&',p);if(amp<0)amp=qs.length();String part=qs.substring(p,amp);if(part.startsWith(needle))return part.substring(needle.length());p=amp+1;}return "";}
String routeOnly(const String &url){int q=url.indexOf('?');return q<0?url:url.substring(0,q);}
void sendHeaders(WiFiClient &c,int code,const char* type,int32_t length=-1,const char* extra=nullptr,const char* cacheControl="no-store"){
  c.print("HTTP/1.1 ");c.print(code);c.println(code==200?" OK":code==400?" Bad Request":code==404?" Not Found":" Error");
  c.print("Content-Type: ");c.println(type);if(length>=0){c.print("Content-Length: ");c.println(length);}if(extra)c.println(extra);c.print("Cache-Control: ");c.println(cacheControl);c.println("Connection: close");c.println();
}
void sendText(WiFiClient &c,int code,const String &v,const char* type="text/plain; charset=utf-8"){sendHeaders(c,code,type,v.length());c.print(v);}
void sendOk(WiFiClient &c){sendText(c,200,"OK");}
float estimateLoggedMB(){if(!sdReady)return -1;uint64_t bytes=0;File dir=SD.open(LOG_DIR);if(dir){for(File f=dir.openNextFile();f;f=dir.openNextFile()){if(!f.isDirectory())bytes+=f.size();f.close();}dir.close();}return max(0.0f,SD_NOMINAL_CAPACITY_MB-(float)bytes/1048576.0f);}

void sendStatus(WiFiClient &c){
  if((uint32_t)(millis()-lastSensorReadMs)>1000)readSensors();DateTime now=rtcReady?rtc.now():DateTime(2000,1,1,0,0,0);double lat=0,lon=0;const char* source;bool pos=selectedPosition(lat,lon,source);
  sendHeaders(c,200,"application/json; charset=utf-8");c.print('{');
  c.print("\"state\":\"");c.print(stateName());c.print("\",\"sessionId\":");c.print(sessionId);c.print(",\"elapsed\":");c.print(elapsedSessionMs()/1000.0,1);c.print(",\"count\":");c.print(measurementCount);c.print(",\"intervalMs\":");c.print(intervalMs);c.print(',');
  c.print("\"shtReady\":");c.print(shtReady?"true":"false");c.print(",\"temperature\":");if(isnan(liveTemp))c.print("null");else c.print(liveTemp,2);c.print(",\"humidity\":");if(isnan(liveHum))c.print("null");else c.print(liveHum,2);c.print(",\"windSpeed\":");if(isnan(liveWind))c.print("null");else c.print(liveWind,2);c.print(",\"windVoltage\":");if(isnan(liveWindVoltage))c.print("null");else c.print(liveWindVoltage,3);c.print(',');
  c.print("\"rtcReady\":");c.print(rtcReady?"true":"false");c.print(",\"rtcSynced\":");c.print(rtcSynced?"true":"false");c.print(",\"rtcTime\":\"");c.print(formatTimeOnly(now));c.print("\",\"sdReady\":");c.print(sdReady?"true":"false");c.print(",\"sdFreeMB\":");c.print(estimateLoggedMB(),1);c.print(',');
  c.print("\"gpsSeen\":");c.print(gpsSeen?"true":"false");c.print(",\"positionValid\":");c.print(pos?"true":"false");c.print(",\"satellites\":");c.print(gps.satellites.isValid()?gps.satellites.value():0);c.print(",\"latitude\":");c.print(lat,6);c.print(",\"longitude\":");c.print(lon,6);c.print(",\"locationSource\":\"");c.print(source);c.print("\"}");
}

bool parseCsvTimestamp(const String &line,DateTime &out){int a=line.indexOf(',');if(a<0)return false;int b=line.indexOf(',',a+1);if(b<0)return false;String v=line.substring(a+1,b);if(v.length()<19)return false;int y=v.substring(0,4).toInt(),mo=v.substring(5,7).toInt(),d=v.substring(8,10).toInt(),h=v.substring(11,13).toInt(),mi=v.substring(14,16).toInt(),se=v.substring(17,19).toInt();if(y<2020)return false;out=DateTime(y,mo,d,h,mi,se);return true;}
struct SessionMeta{uint32_t id=0,count=0,size=0,duration=0;String start="";};
bool sessionMetaFromFile(File &f,uint32_t id,SessionMeta &m){m.id=id;m.size=f.size();String line="";bool header=true,gotFirst=false,gotLast=false;DateTime first,last;while(f.available()){char ch=(char)f.read();if(ch=='\n'){line.trim();if(header)header=false;else if(line.length()){m.count++;DateTime dt;if(parseCsvTimestamp(line,dt)){if(!gotFirst){first=dt;gotFirst=true;m.start=formatDateTime(dt);}last=dt;gotLast=true;}}line="";}else if(ch!='\r'&&line.length()<260)line+=ch;}if(gotFirst&&gotLast){int64_t diff=(int64_t)last.unixtime()-(int64_t)first.unixtime();if(diff>0)m.duration=(uint32_t)diff;}f.seek(0);return true;}
void sendSessions(WiFiClient &c){sendHeaders(c,200,"application/json; charset=utf-8");c.print("{\"sessions\":[");bool firstOut=true;if(sdReady){File dir=SD.open(LOG_DIR);if(dir){for(File f=dir.openNextFile();f;f=dir.openNextFile()){if(!f.isDirectory()){String n=String(f.name());int p=n.lastIndexOf('/');if(p>=0)n=n.substring(p+1);if(n.startsWith("S")&&n.endsWith(".CSV")){uint32_t id=n.substring(1,n.length()-4).toInt();SessionMeta m;sessionMetaFromFile(f,id,m);if(!firstOut)c.print(',');firstOut=false;c.print("{\"id\":");c.print(m.id);c.print(",\"count\":");c.print(m.count);c.print(",\"size\":");c.print(m.size);c.print(",\"duration\":");c.print(m.duration);c.print(",\"start\":\"");c.print(m.start);c.print("\"}");}}f.close();}dir.close();}}c.print("]}");}
void sendDownload(WiFiClient &c,uint32_t id){if(!sdReady){sendText(c,404,"SD niet beschikbaar");return;}String path=sessionPath(id);File f=SD.open(path.c_str(),FILE_READ);if(!f){sendText(c,404,"Bestand niet gevonden");return;}String disp="Content-Disposition: attachment; filename=\"DataLogger_meetsessie_"+String(id)+".csv\"";sendHeaders(c,200,"text/csv; charset=utf-8",f.size(),disp.c_str());uint8_t buf[256];while(f.available()){int n=f.read(buf,sizeof(buf));if(n>0)c.write(buf,n);readGps();}f.close();}
void serveManual(WiFiClient &c){
  sendHeaders(c,200,"text/html; charset=utf-8",(int32_t)MANUAL_RAW_LEN,nullptr,"public, max-age=300");
  static uint8_t history[4096];
  uint32_t histPos=0;
  size_t ip=0;
  uint8_t outBuf[192];
  size_t outLen=0;
  auto emitByte=[&](uint8_t b){
    history[histPos & 4095]=b;
    histPos++;
    outBuf[outLen++]=b;
    if(outLen==sizeof(outBuf)){
      c.write(outBuf,outLen);
      outLen=0;
      readGps();
    }
  };
  while(ip<sizeof(MANUAL_LZ) && c.connected()){
    uint8_t ctrl=MANUAL_LZ[ip++];
    if((ctrl&0x80)==0){
      uint16_t n=(uint16_t)ctrl+1;
      for(uint16_t j=0;j<n && ip<sizeof(MANUAL_LZ);j++)emitByte(MANUAL_LZ[ip++]);
    }else{
      if(ip>=sizeof(MANUAL_LZ))break;
      uint8_t len=((ctrl>>4)&0x07)+3;
      uint16_t off=((uint16_t)(ctrl&0x0F)<<8)|MANUAL_LZ[ip++];
      for(uint8_t j=0;j<len;j++){
        uint8_t b=history[(histPos-off)&4095];
        emitByte(b);
      }
    }
  }
  if(outLen)c.write(outBuf,outLen);
  c.flush();
}

void serveHome(WiFiClient &c){const size_t total=sizeof(INDEX_HTML)-1;sendHeaders(c,200,"text/html; charset=utf-8",(int32_t)total,nullptr,"public, max-age=300");size_t sent=0;while(sent<total&&c.connected()){size_t n=min((size_t)768,total-sent);size_t w=c.write(reinterpret_cast<const uint8_t*>(INDEX_HTML)+sent,n);if(!w){delay(2);continue;}sent+=w;readGps();delay(1);}c.flush();}

void handleRequest(WiFiClient &c,const String &url,const String &method){
  String route=routeOnly(url);if(route=="/handleiding"){serveManual(c);return;}if(route=="/"){serveHome(c);return;}if(route=="/ping"){sendText(c,200,"DataLogger OK");return;}if(route=="/api/status"||route=="/status"){sendStatus(c);return;}if(route=="/api/sessions"||route=="/sessions"){sendSessions(c);return;}
  if(route=="/api/start"){if(startSession())sendOk(c);else sendText(c,400,"Starten mislukt");return;}if(route=="/api/pause"){if(sessionState==STATE_RUNNING){pauseSession();sendOk(c);}else sendText(c,400,"Niet actief");return;}if(route=="/api/resume"){if(sessionState==STATE_PAUSED){resumeSession();sendOk(c);}else sendText(c,400,"Niet gepauzeerd");return;}if(route=="/api/stop"){if(sessionState!=STATE_IDLE){stopSession();sendOk(c);}else sendText(c,400,"Geen actieve sessie");return;}
  if(route=="/api/interval"){long ms=queryValue(url,"ms").toInt();if(ms>=500&&ms<=2147483000L){intervalMs=(uint32_t)ms;sendOk(c);}else sendText(c,400,"Interval minimaal 0,5 s");return;}
  if(route=="/api/time"){int y=queryValue(url,"y").toInt(),mo=queryValue(url,"mo").toInt(),d=queryValue(url,"d").toInt(),h=queryValue(url,"h").toInt(),mi=queryValue(url,"mi").toInt(),se=queryValue(url,"s").toInt();if(rtcReady&&y>=2024&&mo>=1&&mo<=12&&d>=1&&d<=31&&h<24&&mi<60&&se<60){rtc.adjust(DateTime(y,mo,d,h,mi,se));rtcSynced=true;sendOk(c);}else sendText(c,400,"Ongeldige tijd");return;}
  if(route=="/api/delete"){uint32_t id=queryValue(url,"id").toInt();String p=sessionPath(id);if(sdReady&&SD.exists(p.c_str())&&SD.remove(p.c_str()))sendOk(c);else sendText(c,404,"Bestand niet gevonden");return;}
  if(route=="/api/download"){sendDownload(c,queryValue(url,"id").toInt());return;}sendText(c,404,"Niet gevonden");
}
void handleWebClient(){WiFiClient c=server.available();if(!c)return;c.setTimeout(1200);uint32_t started=millis();String line="";while(c.connected()&&(uint32_t)(millis()-started)<2000){readGps();if(c.available()){char ch=(char)c.read();if(ch=='\n')break;if(ch!='\r'&&line.length()<500)line+=ch;}else delay(1);}if(line.length()){int s1=line.indexOf(' '),s2=line.indexOf(' ',s1+1);if(s1>0&&s2>s1){String method=line.substring(0,s1),url=line.substring(s1+1,s2);while(c.connected()&&c.available()){String h=c.readStringUntil('\n');if(h=="\r"||h.length()<=1)break;}handleRequest(c,url,method);}}delay(2);c.stop();}

void setup(){
  Serial.begin(115200);delay(200);Wire.begin();Serial1.begin(GPS_BAUD);analogReadResolution(12);pinMode(WIND_PIN,INPUT);
  rtcReady=rtc.begin();if(rtcReady){if(!rtc.isrunning()){rtc.adjust(DateTime(F(__DATE__),F(__TIME__)));rtcSynced=false;}else{DateTime n=rtc.now();rtcSynced=n.year()>=2024&&n.year()<=2100;}}
  shtReady=sht31.begin(0x44);sdReady=SD.begin(SD_CS_PIN);if(sdReady)ensureLogDir();readSensors();
  WiFi.beginAP(WIFI_SSID,WIFI_PASS);delay(500);server.begin();
  Serial.println("\nDataLogger Toolkit 3 gestart");Serial.print("SHT31: ");Serial.println(shtReady?"actief":"niet gevonden");Serial.print("Open: http://");Serial.println(WiFi.localIP());
}
void loop(){
  readGps();uint32_t now=millis();
  if(sessionState==STATE_RUNNING&&(uint32_t)(now-lastMeasureMs)>=intervalMs){lastMeasureMs+=intervalMs;logMeasurement();}
  else if(sessionState!=STATE_RUNNING&&(uint32_t)(now-lastSensorReadMs)>=1000)readSensors();
  handleWebClient();
}
