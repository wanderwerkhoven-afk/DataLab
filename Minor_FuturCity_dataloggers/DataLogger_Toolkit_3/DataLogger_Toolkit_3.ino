<section id="measure" class="page"><div class="sheet"><div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:9px"><button style="background:none;color:var(--navy);font-size:23px" aria-label="Terug naar dashboard" onclick="navigate('home')">‹</button><strong>Meten</strong><span style="width:38px" aria-hidden="true"></span></div><div class="heading"><div><h1 id="headline">Klaar voor nieuwe meetsessie</h1><p>Nieuwe meetsessie</p></div><span class="pill" id="badge">Stand-by</span></div><div class="clock" aria-label="Meetsessiestatistieken"><div class="metric"><span class="metric-label">Verstreken tijd</span><strong id="elapsed">00:00:00</strong></div><div class="metric"><span class="metric-label">Aantal metingen</span><strong id="count">0</strong></div></div><div class="settingrow"><div>⏱ <b>Meetinterval</b><small id="intervalcaption">Elke 1 seconde</small></div><button onclick="changeInterval()">Wijzigen</button></div><div id="activecontrols" class="measureactions hidden"><button class="continue" id="continuebtn" onclick="resumeOrNotice()">▶ Doorgaan</button><button class="pause" id="pausebtn" onclick="togglePause()">Ⅱ Pauzeren</button></div><button id="stopbtn" class="stop hidden" onclick="openStop()">■ &nbsp; Stop sessie</button><button id="startbtn" class="startbtn" onclick="start()"><span aria-hidden="true" style="display:inline-flex;vertical-align:middle;margin-right:7px"><svg class="playIconSvg" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M8.5 6.8v10.4c0 .8.9 1.3 1.6.9l8-5.2a1.05 1.05 0 0 0 0-1.8l-8-5.2c-.7-.4-1.6.1-1.6.9Z" fill="currentColor"/></svg></span>START MET METEN</button><div class="measuregrid"><div class="tile"><div class="tileicon"><span class="iconwrap"><span class="symbol" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M10 14.5V5.5a2 2 0 1 1 4 0v9a4.5 4.5 0 1 1-4 0Z" stroke="#F2A51A" stroke-width="1.8" stroke-linecap="round" stroke-