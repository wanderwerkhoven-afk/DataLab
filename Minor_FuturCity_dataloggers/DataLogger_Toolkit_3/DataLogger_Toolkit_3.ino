.8" stroke-linecap="round"/><path d="M3 16h8" stroke="#31A268" stroke-width="1.8" stroke-linecap="round"/></svg></span></span></div><div class="tilecontent"><div class="label">Windsnelheid</div><div class="value" id="measureWind">-- m/s</div><div class="sub">JL-FS2 · analoog A0</div></div></div><div class="tile"><div class="tileicon"><span class="iconwrap"><span class="symbol" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M3.8 6.2 8.8 4l6.4 2.1 5-2.1v13.8l-5 2.2-6.4-2.2-5 2.2V6.2Z" stroke="#31A268" stroke-width="1.6" stroke-linejoin="round"/><path d="M8.8 4v13.8M15.2 6.1V20" stroke="#31A268" stroke-width="1.4"/><path d="M12 8.2c-2 0-3.4 1.4-3.4 3.3 0 2.8 3.4 5.9 3.4 5.9s3.4-3.1 3.4-5.9c0-1.9-1.4-3.3-3.4-3.3Z" fill="#31A268" opacity=".16" stroke="#31A268" stroke-width="1.6"/><circle cx="12" cy="11.5" r="1.3" fill="#31A268"/></svg></span></span></div><div class="tilecontent"><div class="label">GPS status</div><div class="value" id="measureGps">Wachten</div><div class="sub" id="measureSats">0 satellieten</div></div></div><div class="tile"><div class="tileicon"><span class="iconwrap"><span class="symbol" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M7 3.8h7.7l4.5 4.5v11.9H7V3.8Z" stroke="#253044" stroke-width="1.8" stroke-linejoin="round" fill="none"/><path d="M14.7 3.8v4.7h4.5" stroke="#253044" stroke-width="1.8" stroke-linejoin="round"/><path d="M9.2 8.1h1.2M11.6 8.1h1.2M14 8.1h1.2" stroke="#253044" stroke-width="1.6" stroke-linecap="round"/><path d="M9.3 11.8h7.5v5.3H9.3z" fill="#253044" opacity=".14" stroke="#253044" stroke-width="1.5"/></svg></span></span></div><div class="tilecontent"><div class="label">SD kaart <span style="color:var(--green)">●</span></div><div class="value" id="sdwrite">Gereed</div><div class="sub" id="measureSdFree">-- vrij</div></div></div></div><div class="location"><div class="map" aria-label="Huidige GPS-locatie"></div><div class="l