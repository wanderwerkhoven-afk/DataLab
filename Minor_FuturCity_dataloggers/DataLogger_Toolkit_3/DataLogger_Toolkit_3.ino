<div class="connectionlost" id="connectionLost" role="dialog" aria-modal="true" aria-labelledby="connectionLostTitle">
  <div class="connectionlost-inner">
    <div class="connectionlost-brand">Data<span>Logger</span></div>
    <div class="connectionlost-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M5 9.5a10.5 10.5 0 0 1 14 0M8.2 12.8a5.8 5.8 0 0 1 7.6 0M11 16a1.5 1.5 0 0 1 2 0" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><path d="M4 4l16 16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></div>
    <h1 id="connectionLostTitle">Je bent niet verbonden met het wifi-signaal van de Arduino-DataLogger.</h1>
    <p>Check de volgende onderdelen om weer connectie te maken.</p>
    <div class="connectionchecklist">
      <div class="connectioncheck"><div class="connectioncheck-num">1</div><div><b>Controleer de stroomvoorziening</b><small>Controleer of de Arduino-DataLogger aan staat en voeding krijgt via USB, powerbank of een geschikte externe voeding.</small></div></div>
      <div class="connectioncheck"><div class="connectioncheck-num">2</div><div><b>Maak opnieuw verbinding met het wifi-signaal</b><small>Open de wifi-instellingen van je telefoon en verbind opnieuw met het netwerk van de DataLogger.</small></div></div>
      <div class="connectioncheck"><div class="connectioncheck-num">3</div><div><b>Herlaad daarna de website</b><small>Zodra je telefoon weer verbonden is met de DataLogger kun je deze pagina opnieuw laden.</small></div></div>
    </div>
    <div class="connectionwifi">Wifi-netwerk: <code>Arduino-Logger</code><br>Wachtwoord: <code>Logger2026!</code></div>
    <div class="connectionactions"><button class="connectionretry" onclick="retryArduinoConnection()">Opnieuw proberen</button><button class="connectionreload" onclick="location.reload()">Website herladen</button></div>
    <div class="connectionstate" id="connectionState">Wachten op verbinding met de Arduino-DataLogger…</div>
  </div>
</div>
<div class="modaloverlay" id="modal"><div class="modal"><header><h2 id="modaltitle">Instellingen</h2><button class="close" aria-label="Sluiten" onclick="closeModal()">✕</button></header><div id="modalbody"></div></div></div><div id="toast" class="toast" role="status"></div>
<script>
let mode='idle',seconds=0,count=0,interval=1,toastTimer,guideStep=0;
let dataSort='newest',dataPeriod=30,chartMetric='temperature',sessions=[],statusData={},sessionCsvCache=new Map();
const $=x=>document.getElementById(x);
let connectionFailures=0,connectionOverlayVisible=false;
const OFFLINE_HELP={title:'Je bent niet verbonden met het wifi-signaal van de Arduino-DataLogger.',steps:['Controleer of de Arduino-DataLogger stroom heeft.','Verbind je telefoon met wifi-netwerk Arduino-Logger.','Herlaad de website nadat de wifi-verbinding hersteld is.'],ssid:'Arduino-Logger'};
try{localStorage.setItem('datalogger-offline-help',JSON.stringify(OFFLINE_HELP));localStorage.setItem('datalogger-last-app-url',location.href)}catch(e){}
function showConnectionLost(){connectionOverlayVisible=true;const el=$('connectionLost');if(el)el.classList.add('show');const st=$('connectionState');if(st)st.textContent='Geen verbinding met de Arduino-DataLogger.'}
function hideConnectionLost(){connectionOverlayVisible=false;const el=$('connectionLost');if(el)el.classList.remove('show');const st=$('connectionState');if(st)st.textContent='Verbonden.'}
function noteConnectionSuccess(){connectionFailures=0;if(connectionOverlayVisible)hideConnectionLost()}
function noteConnectionFailure(){connectionFailures++;if(connectionFailures>=2)showConnectionLost()}
async function retryArduinoConnection(){const st=$('connectionState');if(st)st.textContent='Verbinding controleren…';try{const r=await fetch('/api/status?reconnect='+Date.now(),{cache:'no-store'});if(!r.ok)throw new Error('HTTP '+r.status);const s=await r.json();noteConnectionSuccess();updateUiFromStatus(s);if(st)st.textContent='Verbonden.'}catch(e){showConnectionLost();if(st)st.textContent='Nog geen verbinding. Controleer stroom en wifi.'}}
const esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
async function api(url){try{const r=await fetch(url,{cache:'no-store'});if(!r.ok)throw new Error(await r.text()||('HTTP '+r.status));noteConnectionSuccess();return r}catch(e){noteConnectionFailure();throw e}}
async function apiJson(url){return (await api(url)).json()}
function notify(t){$('toast').textContent=t;$('toast').classList.add('show');clearTimeout(toastTimer);toastTimer=setTimeout(()=>$('toast').classList.remove('show'),2500)}
function navigate(id){document.querySelectorAll('.page').forEach(p=>p.classList.toggle('current',p.id===id));document.querySelectorAll('.nav button').forEach(b=>{b.classList.toggle('selected',b.dataset.page===id);b.setAttribute('aria-current',b.dataset.page===id?'page':'false')});if(id==='data')loadSessions();if(id==='charts'){loadSessions().then(()=>{syncChartSessions();renderChart()})}scrollTo(0,0)}
function fmtClock(total){total=Math.max(0,Math.floor(Number(total)||0));let h=String(Math.floor(total/3600)).padStart(2,'0'),m=String(Math.floor(total%3600/60)).padStart(2,'0'),s=String(total%60).padStart(2,'0');return h+':'+m+':'+s}
function fmtSizeBytes(bytes){bytes=Math.max(0,Number(bytes)||0);if(bytes>=1073741824)return (bytes/1073741824).toFixed(1).replace('.',',')+' GB';if(bytes>=1048576)return (bytes/1048576).toFixed(1).replace('.',',')+' MB';if(bytes>=1024)return Math.max(1,Math.round(bytes/1024))+' KB';return bytes+' B'}
function fmtFreeMB(mb){mb=Number(mb);if(!Number.isFinite(mb)||mb<0)return 'SD gereed';if(mb>=1024)return (mb/1024).toFixed(1).replace('.',',')+' GB vrij';return Math.round(mb)+' MB vrij'}
function dateNl(iso){if(!iso)return 'Onbekende datum';const m=String(iso).match(/^(\d{4})-(\d{2})-(\d{2})/);if(!m)return iso;const months=['jan','feb','mrt','apr','mei','jun','jul','aug','sep','okt','nov','dec'];return Number(m[3])+' '+months[Number(m[2])-1]+' '+m[1]}
function updateUiFromStatus(s){statusData=s;mode=(s.state||'idle').toLowerCase();seconds=Number(s.elapsed)||0;count=Number(s.count)||0;interval=(Number(s.intervalMs)||1000)/1000;  $('elapsed').textContent=fmtClock(seconds);$('count').textContent=count.toLocaleString('nl-NL');
  $('headline').textContent=mode==='running'?'Meetsessie actief':mode==='paused'?'Meetsessie gepauzeerd':'Klaar voor nieuwe meetsessie';
  $('badge').textContent=mode==='running'?'Actief':mode==='paused'?'Gepauzeerd':'Stand-by';
  $('badge').style.background=mode==='running'?'#d8f5e3':mode==='paused'?'#fff0d3':'#e9edf3';
  $('activecontrols').classList.toggle('hidden',mode==='idle');$('stopbtn').classList.toggle('hidden',mode==='idle');$('startbtn').classList.toggle('hidden',mode!=='idle');
  $('pausebtn').innerHTML=mode==='paused'?'<span aria-hidden="true" style="display:inline-flex;vertical-align:middle;margin-right:6px"><svg class="playIconSvg" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M8.5 6.8v10.4c0 .8.9 1.3 1.6.9l8-5.2a1.05 1.05 0 0 0 0-1.8l-8-5.2c-.7-.4-1.6.1-1.6.9Z" fill="currentColor"/></svg></span>Verder meten':'Ⅱ Pauzeren';$('continuebtn').innerHTML=mode==='paused'?'<span aria-hidden="true" style="display:inline-flex;vertical-align:middle;margin-right:6px"><svg class="playIconSvg" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M8.5 6.8v10.4c0 .8.9 1.3 1.6.9l8-5.2a1.05 1.05 0 0 0 0-1.8l-8-5.2c-.7-.4-1.6.1-1.6.9Z" fill="currentColor"/></svg></span>Verder meten':'<span aria-hidden="true" style="display:inline-flex;vertical-align:middle;margin-right:6px"><svg class="playIconSvg" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M8.5 6.8v10.4c0 .8.9 1.3 1.6.9l8-5.2a1.05 1.05 0 0 0 0-1.8l-8-5.2c-.7-.4-1.6.1-1.6.9Z" fill="currentColor"/></svg></span>Doorgaan';
  $('intervalcaption').textContent='Elke '+String(interval).replace('.',',')+' '+(interval===1?'seconde':'seconden');const si=$('settingsInterval');if(si)si.textContent=String(interval).replace('.',',')+' s';
  const temp=Number(s.temperature),hum=Number(s.humidity),tempText=Number.isFinite(temp)?temp.toFixed(2).replace('.',',')+' °C':'-- °C',humText=Number.isFinite(hum)?hum.toFixed(1).replace('.',',')+' %':'-- %';
  if($('homeTemp'))$('homeTemp').textContent=tempText;if($('measureTemp'))$('measureTemp').textContent=tempText;if($('homeHum'))$('homeHum').textContent=humText;if($('measureHum'))$('measureHum').textContent=humText;const wind=Number(s.windSpeed),windTxt=Number.isFinite(wind)?wind.toFixed(1).replace('.',',')+' m/s':'-- m/s';if($('homeWind'))$('homeWind').textContent=windTxt;if($('measureWind'))$('measureWind').textContent=windTxt;
  const fix=!!s.positionValid,gpsTxt=fix?'Satelliet gevonden':'Geen satelliet gevonden',satTxt=(Number(s.satellites)||0)+' satellieten';if($('homeGps'))$('homeGps').textContent=gpsTxt;if($('measureGps'))$('measureGps').textContent=gpsTxt;if($('homeSats'))$('homeSats').textContent=satTxt;if($('measureSats'))$('measureSats').textContent=satTxt;
  if($('homeTime'))$('homeTime').textContent=s.rtcTime||'--:--:--';if($('homeTimeStatus'))$('homeTimeStatus').textContent=s.rtcSynced?'Gesynchroniseerd':'Synchroniseren';if($('settingsTimeStatus'))$('settingsTimeStatus').textContent=s.rtcSynced?'Gesynchroniseerd':'Synchroniseren';
  const sdOk=!!s.sdReady,free=fmtFreeMB(s.sdFreeMB);if($('homeSdStatus'))$('homeSdStatus').textContent=sdOk?'Gereed':'Fout';if($('homeSdFree'))$('homeSdFree').textContent=free;if($('measureSdFree'))$('measureSdFree').textContent=free;if($('sdwrite'))$('sdwrite').textContent=mode==='running'?'Schrijven...':sdOk?'Gereed':'Fout';
  if($('systemSensors'))$('systemSensors').textContent=(s.shtReady&&s.sdReady&&s.rtcReady)?'Wind + temperatuur actief':'Controleer systeemstatus';
  if($('measureCoords'))$('measureCoords').innerHTML=fix?(Number(s.latitude).toFixed(6)+'° N<br>'+Number(s.longitude).toFixed(6)+'° E'):'Geen actuele positie';if($('measureAccuracy'))$('measureAccuracy').innerHTML=fix?('Bron: '+esc(s.locationSource||'GPS')):'Wachten op GPS-satelliet';
}
async function pollStatus(){try{updateUiFromStatus(await apiJson('/api/status'))}catch(e){if($('systemSensors'))$('systemSensors').textContent='Verbinding verbroken'}}
async function start(){try{await api('/api/start');await pollStatus();notify('Nieuwe meetsessie gestart')}catch(e){notify('Starten mislukt: '+e.message)}}
async function togglePause(){try{await api(mode==='paused'?'/api/resume':'/api/pause');await pollStatus();notify(mode==='paused'?'Meting gepauzeerd':'Status bijgewerkt')}catch(e){notify('Actie mislukt: '+e.message)}}
function resumeOrNotice(){if(mode==='paused')togglePause();else notify('Je bent al aan het meten')}
function openStop(){openModal('stop')}
async function finish(){try{await api('/api/stop');closeModal();await pollStatus();await loadSessions();notify('Meetsessie opgeslagen op SD-kaart')}catch(e){notify('Stoppen mislukt: '+e.message)}}
function getDisplaySessions(){let list=[...sessions];const q=($('searchSessions')?.value||'').trim().toLowerCase();if(q)list=list.filter(f=>('datalogger_meetsessie_'+f.id).includes(q)||String(f.id).includes(q));if(dataPeriod>0){const cutoff=Date.now()-dataPeriod*86400000;list=list.filter(f=>{if(!f.start)return true;const t=Date.parse(f.start.replace(' ','T'));return !Number.isFinite(t)||t>=cutoff})}list.sort((a,b)=>dataSort==='oldest'?a.id-b.id:dataSort==='largest'?b.size-a.size:b.id-a.id);return list}
async function loadSessions(){try{const j=await apiJson('/api/sessions');sessions=Array.isArray(j.sessions)?j.sessions:[];renderFiles();syncChartSessions();return sessions}catch(e){sessions=[];renderFiles();return []}}
function renderFiles(){const list=getDisplaySessions(),root=$('sessionList');if(!root)return;root.replaceChildren();if(!list.length){root.innerHTML='<div class="emptyhint">Geen sessies gevonden.</div>'}else list.forEach(f=>{const row=document.createElement('div');row.className='sessionrow';const icon=document.createElement('div');icon.className='fileicon';icon.innerHTML='<svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M7 3.8h7.7l4.5 4.5v11.9H7V3.8Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M14.7 3.8v4.7h4.5" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>';const info=document.createElement('div');info.style.minWidth='0';info.innerHTML='<div class="sessiontitle">DataLogger_meetsessie_'+f.id+'</div><div class="sessionmeta">'+esc(dateNl(f.start))+' &nbsp; '+esc(fmtClock(f.duration))+'</div><div class="sessionsub">'+Number(f.count||0).toLocaleString('nl-NL')+' metingen &nbsp; · &nbsp; '+esc(fmtSizeBytes(f.size||0))+'</div>';const btn=document.createElement('button');btn.className='sessionmenubtn';btn.type='button';btn.setAttribute('aria-label','Acties voor meetsessie '+f.id);btn.innerHTML='⋮';btn.onclick=()=>openSessionActions(f);row.append(icon,info,btn);root.appendChild(row)});
  const all=sessions;$('statSessions').textContent=all.length;$('statMeasurements').textContent=all.reduce((a,b)=>a+(Number(b.count)||0),0).toLocaleString('nl-NL');$('statSize').textContent=fmtSizeBytes(all.reduce((a,b)=>a+(Number(b.size)||0),0));}
function sessionByNumber(n){return sessions.find(x=>Number(x.id)===Number(n))}
function toggleFilters(){const p=$('filterPanel'),b=$('filterButton');p.hidden=!p.hidden;b.classList.toggle('active',!p.hidden)}
function setDataSort(s){dataSort=s;document.querySelectorAll('.filteroption').forEach(b=>b.classList.toggle('active',b.dataset.sort===s));renderFiles()}
function cyclePeriod(){const opts=[30,90,365,0],labels={30:'Laatste 30 dagen ˅',90:'Laatste 90 dagen ˅',365:'Laatste jaar ˅',0:'Alle data ˅'};dataPeriod=opts[(opts.indexOf(dataPeriod)+1)%opts.length];$('periodButton').textContent=labels[dataPeriod];renderFiles()}
function openSessionActions(f){$('modaltitle').textContent='Meetsessie '+f.id;$('modalbody').innerHTML='<div class="sessionactionsheet"><button class="sessionaction" onclick="downloadCSVByNumber('+f.id+')"><span class="saicon">⇩</span><span>Downloaden<small>Download als CSV-bestand</small></span></button><button class="sessionaction" onclick="shareSession('+f.id+')"><span class="saicon">↗</span><span>Delen<small>Deel het CSV-bestand</small></span></button><button class="sessionaction" onclick="inspectSession('+f.id+')"><span class="saicon">⌕</span><span>Data inkijken<small>Bekijk alle gemeten waarden</small></span></button><button class="sessionaction danger" onclick="confirmDeleteSession('+f.id+')"><span class="saicon">⌫</span><span>Verwijderen<small>Verwijder deze meetsessie permanent</small></span></button></div>';$('modal').classList.add('open')}
function downloadCSVByNumber(n){location.href='/api/download?id='+encodeURIComponent(n)}
async function getSessionCsv(n,refresh=false){if(!refresh&&sessionCsvCache.has(n))return sessionCsvCache.get(n);const t=await (await api('/api/download?id='+encodeURIComponent(n))).text();sessionCsvCache.set(n,t);return t}
async function shareSession(n){const f=sessionByNumber(n);if(!f)return;try{const text=await getSessionCsv(n,true),file=new File([text],'DataLogger_meetsessie_'+n+'.csv',{type:'text/csv'});if(navigator.canShare&&navigator.canShare({files:[file]})&&navigator.share){await navigator.share({title:'DataLogger meetsessie '+n,files:[file]})}else if(navigator.share){await navigator.share({title:'DataLogger meetsessie '+n,text:'DataLogger_meetsessie_'+n+'.csv'})}else{downloadCSVByNumber(n);notify('Delen niet ondersteund; CSV wordt gedownload')}}catch(e){if(e.name!=='AbortError')notify('Delen mislukt')}}
function parseCSV(text){const lines=text.replace(/\r/g,'').split('\n').filter(Boolean);if(!lines.length)return {headers:[],rows:[]};const headers=lines[0].split(',').map(x=>x.trim());return {headers,rows:lines.slice(1).map(line=>{const a=line.split(',');const o={};headers.forEach((h,i)=>o[h]=a[i]??'');return o})}}
async function inspectSession(n){const f=sessionByNumber(n);if(!f)return;$('modaltitle').textContent='DataLogger_meetsessie_'+n;$('modalbody').innerHTML='<div class="datatableempty">Meetdata laden...</div>';$('modal').classList.add('open');try{const p=parseCSV(await getSessionCsv(n));const rows=p.rows;const pick=(r,...names)=>{for(const k of names)if(k in r)return r[k];return ''};let trs=rows.map((r,i)=>'<tr><td class="num">'+esc(pick(r,'measurement_id')||i+1)+'</td><td>'+esc((pick(r,'rtc_datetime_local')||'').split(' ')[1]||pick(r,'rtc_datetime_local'))+'</td><td class="num">'+esc(pick(r,'temperature_C'))+'</td><td class="num">'+esc(pick(r,'humidity_pct'))+'</td><td class="num">'+esc(pick(r,'wind_speed_ms'))+'</td><td class="num">'+esc(pick(r,'latitude'))+'</td><td class="num">'+esc(pick(r,'longitude'))+'</td></tr>').join('');if(!trs)trs='<tr><td colspan="7" class="datatableempty">Deze sessie bevat nog geen meetpunten.</td></tr>';$('modalbody').innerHTML='<div class="datatablewrap"><table class="datatable"><thead><tr><th>#</th><th>Tijd</th><th class="num">Temp °C</th><th class="num">RV %</th><th class="num">Wind m/s</th><th class="num">Latitude</th><th class="num">Longitude</th></tr></thead><tbody>'+trs+'</tbody></table></div>'}catch(e){$('modalbody').innerHTML='<div class="datatableempty">Data laden mislukt: '+esc(e.message)+'</div>'}}
function confirmDeleteSession(n){const f=sessionByNumber(n);if(!f)return;$('modaltitle').textContent='Meetsessie verwijderen?';$('modalbody').innerHTML='<p style="font-size:13px;color:var(--muted);line-height:1.5">DataLogger_meetsessie_'+n+' wordt permanent van de SD-kaart verwijderd. Dit kan niet ongedaan worden gemaakt.</p><div class="measureactions"><button class="continue" onclick="openSessionActions(sessionByNumber('+n+'))">Annuleren</button><button class="stop" onclick="deleteSession('+n+')">Verwijderen</button></div>'}
async function deleteSession(n){try{await api('/api/delete?id='+encodeURIComponent(n));sessionCsvCache.delete(n);closeModal();await loadSessions();notify('Meetsessie verwijderd')}catch(e){notify('Verwijderen mislukt: '+e.message)}}
