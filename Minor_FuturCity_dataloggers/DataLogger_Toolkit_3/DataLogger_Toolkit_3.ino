function guideNext(){if(guideStep<GUIDE_STEPS.length-1){guideStep++;renderGuide()}}
function guidePrev(){if(guideStep>0){guideStep--;renderGuide()}}
function guideThemeSwitch(name){const sw=$('guideThemeSwitch');if(sw){const dark=name==='dark';sw.dataset.active=dark?'dark':'light';const b=sw.querySelectorAll('button');b[0]?.classList.toggle('active',!dark);b[1]?.classList.toggle('active',dark)}theme(name)}
async function syncTimeFromPhone(){const d=new Date(),q=`/api/time?y=${d.getFullYear()}&mo=${d.getMonth()+1}&d=${d.getDate()}&h=${d.getHours()}&mi=${d.getMinutes()}&s=${d.getSeconds()}`;try{await api(q);await pollStatus();const m=$('modalTimeState');if(m)m.textContent='Zojuist gesynchroniseerd';const p=$('phoneTimePreview');if(p)p.textContent=d.toLocaleTimeString('nl-NL');notify('Tijd gesynchroniseerd met telefoon')}catch(e){notify('Synchroniseren mislukt')}}
function theme(name){const c=name==='dark'?'dark':'light';document.documentElement.setAttribute('data-theme',c);try{localStorage.setItem('datalogger-theme',c)}catch(e){}$('themeLight')?.setAttribute('aria-pressed',String(c==='light'));$('themeDark')?.setAttribute('aria-pressed',String(c==='dark'));const sw=$('themeSwitch');if(sw)sw.dataset.active=c;$('browserThemeColor').setAttribute('content',c==='dark'?'#232323':'#343F58')}
function chooseInterval(n){window.pendingInterval=n;$('customSeconds').value='';$('intervalCustom').classList.remove('selected');$('intervalError').textContent='';document.querySelectorAll('.interval-choice').forEach(b=>b.setAttribute('aria-pressed',String(Number(b.querySelector('span').textContent)===n)));$('intervalHelp').textContent='Iedere '+String(n).replace('.',',')+' seconde(n) een meetpunt.'}
function customIntervalChanged(){const input=$('customSeconds'),raw=input.value.trim().replace(',','.'),n=Number(raw),valid=/^\d+(?:\.\d{1,3})?$/.test(raw)&&n>=0.1&&n<=2147483&&Number.isInteger(Math.round(n*1000));document.querySelectorAll('.interval-choice').forEach(b=>b.setAttribute('aria-pressed','false'));$('intervalCustom').classList.toggle('selected',valid);$('intervalError').textContent=raw&&!valid?'Vul minimaal 0,1 seconde in, met maximaal drie decimalen.':'';window.pendingInterval=valid?n:null;$('intervalHelp').textContent=valid?'Iedere '+String(n).replace('.',',')+' seconde(n) een meetpunt.':'Vul zelf je interval in, bijvoorbeeld 0,1, 0,25 of 120.'}
async function saveInterval(){const n=window.pendingInterval;if(!Number.isFinite(n)||n<0.1){$('intervalError').textContent='Kies minimaal 0,1 seconde.';return}try{await api('/api/interval?ms='+Math.round(n*1000));closeModal();await pollStatus();notify('Meetinterval gewijzigd naar '+String(n).replace('.',',')+' s')}catch(e){notify('Interval opslaan mislukt')}}
function openModal(which){const title=$('modaltitle'),body=$('modalbody');body.replaceChildren();if(which==='stop'){title.textContent='Meetsessie stoppen?';body.innerHTML='<p>Je sluit deze meetsessie definitief af en bewaart de gegevens. Pauzeren houdt dezelfde sessie open.</p><div class="measureactions"><button class="continue" onclick="closeModal()">Annuleren</button><button class="stop" onclick="finish()">Stop en bewaar</button></div>'}
else if(which==='interval'){title.textContent='Meetinterval';body.innerHTML='<p class="interval-intro">Kies hoe vaak je DataLogger een nieuw meetpunt opslaat.</p><div class="interval-choices" id="intervalChoices" role="group" aria-label="Meetinterval kiezen"></div><div class="interval-custom" id="intervalCustom"><label for="customSeconds">Zelf aantal seconden invullen<small>Ook decimalen mogelijk, bijvoorbeeld 0,1 of 0,25 seconde</small></label><input id="customSeconds" type="text" inputmode="decimal" autocomplete="off" placeholder="bijv. 0,1" oninput="customIntervalChanged()"></div><p class="interval-error" id="intervalError" role="alert"></p><div class="interval-help" id="intervalHelp"></div><button class="startbtn interval-save" onclick="saveInterval()">Interval opslaan</button>';window.pendingInterval=interval;[0.1,0.5,1,2,5,10,30,60].forEach(n=>{const b=document.createElement('button');b.className='interval-choice';b.type='button';b.setAttribute('aria-pressed',String(n===interval));b.innerHTML='<span>'+n+'</span><small>'+(n===1?'seconde':'seconden')+'</small>';b.onclick=()=>chooseInterval(n);$('intervalChoices').appendChild(b)});if(![0.1,0.5,1,2,5,10,30,60].includes(interval)){$('customSeconds').value=String(interval).replace('.',',');customIntervalChanged()}else chooseInterval(interval)}
else if(which==='system'){title.textContent='Systeemstatus';const s=statusData;body.innerHTML='<div class="modalinfo"><div class="modalinforow"><span>SHT31 temperatuur</span><span>'+(s.shtReady?'Actief':'Niet gevonden')+'</span></div><div class="modalinforow"><span>Air530Z GPS</span><span>'+(s.gpsSeen?'NMEA actief':'Geen data')+'</span></div><div class="modalinforow"><span>SD-kaart</span><span>'+(s.sdReady?'Gereed':'Fout')+'</span></div><div class="modalinforow"><span>DS1307 tijd</span><span>'+(s.rtcReady?'Actief':'Niet gevonden')+'</span></div><div class="modalinforow"><span>WiFi</span><span>Arduino-Logger-03</span></div></div>'}
else if(which==='timesync'){title.textContent='Synchroniseer de tijd';body.innerHTML='<p style="font-size:13px;color:var(--muted);line-height:1.5">Synchroniseer de tijd van je DataLogger met de actuele tijd van deze telefoon. Dit is belangrijk voor tijdsafhankelijke metingen.</p><div class="modalinfo"><div class="modalinforow"><span>Status</span><span id="modalTimeState">'+(statusData.rtcSynced?'Gesynchroniseerd':'Nog synchroniseren')+'</span></div><div class="modalinforow"><span>Telefoontijd</span><span id="phoneTimePreview">'+new Date().toLocaleTimeString('nl-NL')+'</span></div></div><button class="modalaction" onclick="syncTimeFromPhone()">Synchroniseer tijd</button>'}
else if(which==='about'){title.textContent='Over je DataLogger';body.innerHTML='<section><b>Arduino UNO R4 WiFi</b><p>Microcontroller en lokaal WiFi-netwerk.</p></section><section><b>Grove Air530Z</b><p>GPS-positie, snelheid en UTC-tijd via UART.</p></section><section><b>Grove SHT31</b><p>Temperatuur en luchtvochtigheid via I²C.</p></section><section><b>DFRobot JL-FS2</b><p>Windsnelheid via 0–5 V analoge uitgang op A0. Externe 9–24 V voeding met gedeelde GND.</p></section><section><b>Keyes Logging Shield</b><p>SD-kaart en DS1307-klok met reservebatterij.</p></section>'}
else if(which==='guide'){guideStep=0;renderGuide()}$('modal').classList.add('open')}
function syncChartSessions(){const sel=$('chartSession');if(!sel)return;const prev=sel.value;sel.innerHTML='<option value="">Selecteer een meetsessie</option>';sessions.forEach(f=>{const o=document.createElement('option');o.value=String(f.id);o.textContent='Meetsessie '+f.id+' · '+Number(f.count||0).toLocaleString('nl-NL')+' meetpunten';sel.appendChild(o)});if(sessions.some(f=>String(f.id)===prev))sel.value=prev;else if(sessions.length)sel.value=String(sessions[0].id)}
function setChartMetric(metric){chartMetric=metric;[['metricTemp','temperature'],['metricHum','humidity'],['metricWind','wind']].forEach(([id,k])=>{const b=$(id);if(b)b.classList.toggle('active',metric===k)});renderChart()}
function fmtChartTime(sec){if(sec<60)return Math.round(sec)+' s';if(sec<3600)return Math.round(sec/60)+' min';return (sec/3600).toFixed(1).replace('.',',')+' u'}
async function renderChart(){const canvas=$('chartCanvas'),stats=$('chartStats'),select=$('chartSession');if(!canvas||!select)return;const id=Number(select.value);if(!id){canvas.className='chart-empty';canvas.innerHTML='Kies een opgeslagen meetsessie.';stats.hidden=true;return}canvas.className='chart-empty';canvas.innerHTML='Meetdata laden...';try{const parsed=parseCSV(await getSessionCsv(id)),map={temperature:['temperature_C','°C','Temperatuur',1],humidity:['humidity_pct','%','Luchtvochtigheid',0],wind:['wind_speed_ms','m/s','Windsnelheid',1]},cfg=map[chartMetric]||map.temperature,vals=parsed.rows.map(r=>Number(r[cfg[0]])).filter(Number.isFinite);if(!vals.length)throw new Error('Geen geldige '+cfg[2].toLowerCase()+'data');let min=Math.min(...vals),max=Math.max(...vals);if(max-min<.5){min-=.25;max+=.25}const pad=(max-min)*.14;min-=pad;max+=pad;const w=360,h=220,left=40,right=12,top=16,bottom=30,pw=w-left-right,ph=h-top-bottom,x=i=>left+(i/(vals.length-1||1))*pw,y=v=>top+(max-v)/(max-min)*ph;const pts=vals.map((v,i)=>x(i).toFixed(1)+','+y(v).toFixed(1)).join(' '),area=left+','+(top+ph)+' '+pts+' '+(left+pw)+','+(top+ph);let grid='';for(let i=0;i<=4;i++){const yy=top+i*ph/4,val=max-i*(max-min)/4;grid+='<line class="chartgridline" x1="'+left+'" x2="'+(left+pw)+'" y1="'+yy+'" y2="'+yy+'"/><text class="chartaxis" x="4" y="'+(yy+3)+'">'+val.toFixed(cfg[3])+'</text>'}const last=vals[vals.length-1];canvas.className='chartbox';canvas.innerHTML='<svg viewBox="0 0 '+w+' '+h+'">'+grid+'<polygon class="chartarea" points="'+area+'"/><polyline class="chartline" points="'+pts+'"/><circle class="chartdot" cx="'+x(vals.length-1)+'" cy="'+y(last)+'" r="4"/></svg>';$('chartTitle').textContent=cfg[2];$('chartSubtitle').textContent='Meetsessie '+id+' · '+vals.length+' meetpunten';$('chartLatest').textContent=last.toFixed(cfg[3]).replace('.',',');$('chartUnit').textContent=cfg[1];const avg=vals.reduce((a,b)=>a+b,0)/vals.length;$('chartMin').textContent=Math.min(...vals).toFixed(cfg[3]).replace('.',',')+' '+cfg[1];$('chartAvg').textContent=avg.toFixed(cfg[3]).replace('.',',')+' '+cfg[1];$('chartMax').textContent=Math.max(...vals).toFixed(cfg[3]).replace('.',',')+' '+cfg[1];stats.hidden=false}catch(e){canvas.className='chart-empty';canvas.innerHTML='Grafiek laden mislukt: '+esc(e.message);stats.hidden=true}}
try{theme(localStorage.getItem('datalogger-theme')||'light')}catch(e){theme('light')}
