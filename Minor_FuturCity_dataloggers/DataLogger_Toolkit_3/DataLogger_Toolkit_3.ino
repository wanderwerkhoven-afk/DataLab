<section id="data" class="page"><div class="datawrap"><div class="datatop"><div><h1>Overzicht</h1></div><button class="periodpill" type="button" onclick="cyclePeriod()" id="periodButton">Laatste 30 dagen ˅</button></div><div class="overviewgrid"><div class="overviewcard"><div class="overviewiconrow"><span class="miniicon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M7 3.8h7.7l4.5 4.5v11.9H7V3.8Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M14.7 3.8v4.7h4.5" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg></span></div><div class="overviewvalue" id="statSessions">12</div><div class="overviewlabel">Sessies</div></div><div class="overviewcard"><div class="overviewiconrow"><span class="miniicon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4 18h16M7 18V9m5 9V5m5 13v-7" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></span></div><div class="overviewvalue" id="statMeasurements">3.482</div><div class="overviewlabel">Metingen</div></div><div class="overviewcard"><div class="overviewiconrow"><span class="miniicon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M6.5 6.5A2.5 2.5 0 0 1 9 4h6a2.5 2.5 0 0 1 2.5 2.5v11A2.5 2.5 0 0 1 15 20H9a2.5 2.5 0 0 1-2.5-2.5v-11Z" stroke="currentColor" stroke-width="1.8"/><path d="M9.5 7.5h5M9.5 10.5h5M9.5 13.5h5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg></span></div><div class="overviewvalue" id="statSize">248 MB</div><div class="overviewlabel">Totale grootte</div></div></div><h2 class="sectionhead">Meetbestanden</h2><div class="filetoolbar"><label class="searchbox" aria-label="Zoek in sessies"><span aria-hidden="true">⌕</span><input id="searchSessions" type="text" placeholder="Zoek in sessies..." oninput="renderFiles()"></label><button class="filterbtn" id="filterButton" type="button" onclick="toggleFilters()"><span aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M4 6h16M7 12h10M10 18h4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></span>Filteren</button></div><div class="filterpanel" id="filterPanel" hidden><span class="filterlabel">Sorteer op</span><div class="filteroptions"><button class="filteroption active" data-sort="newest" onclick="setDataSort('newest')">Nieuwste</button><button class="filteroption" data-sort="oldest" onclick="setDataSort('oldest')">Oudste</button><button class="filteroption" data-sort="largest" onclick="setDataSort('largest')">Grootste</button></div></div><div id="sessionList" class="sessionlist"></div></div></section>
<section id="charts" class="page"><div class="chartwrap"><h1>Grafieken</h1><p class="chartintro">Visualiseer de gegevens uit je opgeslagen meetsessies.</p><div class="chartpanel"><label class="chartlabel" for="chartSession">Meetsessie</label><select id="chartSession" class="chartselect" onchange="renderChart()"><option value="">Selecteer een meetsessie</option></select><div style="height:12px"></div><span class="chartlabel">Meetwaarde</span><div class="metricbuttons"><button id="metricTemp" class="active" onclick="setChartMetric('temperature')">Temperatuur</button><button id="metricHum" onclick="setChartMetric('humidity')">Luchtvochtigheid</button><button id="metricWind" onclick="setChartMetric('wind')">Wind</button></div></div><div class="chartpanel"><div class="charthead"><div><h2 id="chartTitle">Meetverloop</h2><small id="chartSubtitle" style="color:var(--muted)">Kies een meetsessie</small></div><div class="chartvalue"><strong id="chartLatest">--</strong><small id="chartUnit"></small></div></div><div id="chartCanvas" class="chart-empty">Stop eerst een meetsessie. Daarna kun je de opgeslagen data hier plotten.</div><div id="chartStats" class="chartstats" hidden><div class="chartstat"><small>Minimum</small><strong id="chartMin">--</strong></div><div class="chartstat"><small>Gemiddeld</small><strong id="chartAvg">--</strong></div><div class="chartstat"><small>Maximum</small><strong id="chartMax">--</strong></div></div><p class="chartnote">Grafieken worden rechtstreeks opgebouwd uit de CSV-bestanden op de SD-kaart.</p></div></div></section>
