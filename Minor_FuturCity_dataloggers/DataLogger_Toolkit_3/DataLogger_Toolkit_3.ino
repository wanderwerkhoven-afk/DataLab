/* Op zeer smalle telefoons blijven sensorcards 2 naast elkaar, maar compacter */
@media(max-width:380px){
  #home .sensors{
    grid-template-columns:1fr 1fr;
    gap:9px;
  }
  #home .sensor{
    min-height:118px;
    grid-template-columns:29% 71%;
  }
  #home .sensoricon{
    padding:10px 5px;
  }
  #home .sensoricon .iconwrap{
    width:44px;
    height:44px;
    flex-basis:44px;
  }
  #home .sensorcontent{
    padding:10px 8px 10px 4px;
  }
  #home .sensor .label{
    font-size:10px;
  }
  #home .sensor .value,
  #home .sensor.emphasis .value{
    font-size:16px;
  }
  #home .sensor.compact .value{
    font-size:15px;
  }
  #home .sensor .sub{
    font-size:9.5px;
  }
}

/* ===== Compacte sticky topbar + kleinere onderruimte ===== */

/* Kleur de iOS safe-area bovenaan hetzelfde als de header */
html{
  background:var(--navy);
}
body{
  background:var(--bg);
}
body::before{
  content:"";
  position:fixed;
  top:0;
  left:0;
  right:0;
  height:env(safe-area-inset-top);
  background:var(--navy);
  z-index:49;
  pointer-events:none;
}

/* Header blijft zichtbaar tijdens scrollen */
.top{
  position:sticky;
  top:0;
  z-index:50;
  min-height:56px;
  padding:calc(env(safe-area-inset-top) + 6px) 14px 7px;
  box-shadow:0 2px 8px rgba(0,0,0,.08);
}
.brand{
  font-size:20px;
  line-height:1;
}
.topGearBtn{
  width:36px;
  height:36px;
}
.topGearIcon{
  width:22px;
  height:22px;
}

/* Minder ruimte onderaan de app */
.page{
  padding-bottom:calc(76px + env(safe-area-inset-bottom));
}
.nav{
  min-height:62px;
  padding:4px 8px calc(5px + env(safe-area-inset-bottom));
}
.nav button{
  min-height:42px;
  padding:2px 0;
}
.navIconWrap,
.nav button>span{
  width:34px;
  height:34px;
}
.navSvgIcon,
.nav .playIconSvg{
  width:23px;
  height:23px;
}
.nav button .chartNavIcon{
  width:34px;
  height:34px;
  padding:6px 7px;
}

/* De laatste content hoeft niet zo ver boven de navigatie te stoppen */
#home .content{
  padding-bottom:14px;
}

/* Mobiel nog compacter */
@media(max-width:430px){
  .top{
    min-height:54px;
    padding:calc(env(safe-area-inset-top) + 5px) 12px 6px;
  }
  .brand{font-size:19px}
  .topGearBtn{width:34px;height:34px}
  .topGearIcon{width:21px;height:21px}

  .page{
    padding-bottom:calc(70px + env(safe-area-inset-bottom));
  }
  .nav{
    min-height:58px;
    padding:3px 8px calc(4px + env(safe-area-inset-bottom));
  }
  .nav button{
    min-height:40px;
  }
  .navIconWrap,
  .nav button>span{
    width:32px;
    height:32px;
  }
  .navSvgIcon,
  .nav .playIconSvg{
    width:22px;
    height:22px;
  }
  .nav button .chartNavIcon{
    width:32px;
    height:32px;
  }
}

/* ===== Iets grotere topbar en menu-iconen ===== */
.top{
  min-height:64px;
  padding:calc(env(safe-area-inset-top) + 8px) 16px 9px;
}
.brand{
  font-size:22px;
}
.topGearBtn{
  width:42px;
  height:42px;
}
.topGearIcon{
  width:25px;
  height:25px;
}

/* Grotere iconen in onderste navigatie, zonder de balk weer veel hoger te maken */
.nav button{
  min-height:44px;
}
.navIconWrap,
.nav button>span{
  width:40px;
  height:40px;
}
.navSvgIcon,
.nav .playIconSvg{
  width:28px;
  height:28px;
}
.nav button .chartNavIcon{
  width:40px;
  height:40px;
  padding:6px 7px;
}
.nav button .chartNavIcon i{
  width:5.5px;
}

/* Actieve achtergrond iets ruimer zodat grote iconen niet krap ogen */
.nav button.selected>span{
  border-radius:13px;
}

/* Mobiel */
@media(max-width:430px){
  .top{
    min-height:62px;
    padding:calc(env(safe-area-inset-top) + 7px) 14px 8px;
  }
  .brand{
    font-size:21px;
  }
  .topGearBtn{
    width:40px;
    height:40px;
  }
  .topGearIcon{
    width:24px;
    height:24px;
  }

  .nav button{
    min-height:43px;
  }
  .navIconWrap,
  .nav button>span{
    width:39px;
    height:39px;
  }
  .navSvgIcon,
  .nav .playIconSvg{
    width:27px;
    height:27px;
  }
  .nav button .chartNavIcon{
    width:39px;
    height:39px;
    padding:6px 7px;
  }
}
