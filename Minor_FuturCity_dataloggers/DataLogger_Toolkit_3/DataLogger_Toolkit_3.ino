.dataviewmeta{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 14px}
.dataviewchip{font-size:12px;color:var(--muted);background:var(--surface-alt);border:1px solid var(--border);border-radius:999px;padding:7px 10px}
.datatablewrap{width:100%;overflow:auto;border:1px solid var(--border);border-radius:14px;background:var(--surface);max-height:52dvh;-webkit-overflow-scrolling:touch}
.datatable{width:100%;border-collapse:separate;border-spacing:0;min-width:760px;font-size:12px;font-variant-numeric:tabular-nums}
.datatable th{position:sticky;top:0;z-index:2;background:var(--navy);color:#fff;text-align:left;padding:11px 10px;font-size:11px;letter-spacing:.15px;white-space:nowrap}
.datatable td{padding:10px;border-bottom:1px solid var(--border);white-space:nowrap;color:var(--ink)}
.datatable tbody tr:last-child td{border-bottom:0}
.datatable tbody tr:nth-child(even){background:var(--surface-alt)}
.datatable .num{text-align:right}
.datatableempty{padding:26px 18px;text-align:center;color:var(--muted);font-size:13px}
.dataviewfooter{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-top:12px}
.dataviewfooter small{color:var(--muted);font-size:11px;line-height:1.35}
.dataviewfooter .modalaction{width:auto;margin:0;padding:0 16px}
@media(max-width:420px){
  .datatablewrap{max-height:48dvh;border-radius:12px}
  .datatable{font-size:11px;min-width:700px}
  .datatable th,.datatable td{padding:9px 8px}
  .dataviewfooter{align-items:flex-start;flex-direction:column}
  .dataviewfooter .modalaction{width:100%}
}
