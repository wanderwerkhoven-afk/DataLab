.top{
  min-height:68px;
  padding:calc(env(safe-area-inset-top) + 12px) 16px 12px;
}
.brand{font-size:22px}
.topGearBtn{
  width:42px;
  height:42px;
  padding:0!important;
  border-radius:12px;
  display:flex;
  align-items:center;
  justify-content:center;
}
.topGearIcon{width:25px;height:25px;display:block}

/* Minder hoge hero zodat de primaire acties sneller zichtbaar zijn */
.hero{
  height:148px;
  padding:20px 18px;
}
.hero h1{
  font-size:23px;
  line-height:1.1;
}
.hero p{
  margin-top:12px;
  font-size:15px;
}
.hero:after{
  height:64px;
  bottom:18px;
}

/* Compactere systeemstatus */
.system{
  left:14px;
  right:14px;
  padding:9px 12px;
  border-radius:14px 14px 0 0;
  font-size:11px;
  align-items:center;
}
.system .dot{
  width:8px;
  height:8px;
  margin-right:6px;
}

/* Meer balans in primaire dashboardtiles */
.content{
  padding:14px;
}
.homeactions{
  gap:12px;
}
.action{
  min-height:122px;
  border-radius:var(--radius-lg);
  padding:15px 10px;
  gap:9px;
}
.action strong{
  font-size:15px;
  line-height:1.2;
}
.action small{
  font-size:11px;
  line-height:1.35;
  opacity:.9;
}
.action .bigicon{
  width:46px;
  height:46px;
}
.action .bigicon svg{
  width:27px;
  height:27px;
}
.playIconWrap,
.dataIconWrap{
  border-radius:14px;
  display:flex;
  align-items:center;
  justify-content:center;
}
.playIconWrap{
  background:rgba(35,35,35,.14);
  color:#232323;
}
.dataIconWrap{
  background:rgba(255,255,255,.12);
  color:#fff;
}
.actionDataIcon{display:block}

/* Rustigere sectiekop */
.sectiontitle{
  margin:20px 3px 12px;
}
.sectiontitle h2{
  font-size:18px;
}
.live{
  font-size:12px;
}
.live .dot{
  width:8px;
  height:8px;
}

/* Sensorcards: meer ruimte voor de meetwaarde */
.sensors{
  gap:12px;
}
.sensor{
  grid-template-columns:28% 72%;
  min-height:134px;
  border-radius:var(--radius-md);
}
.sensor.compact{
  min-height:124px;
}
.sensoricon{
  padding:14px 10px;
}
.sensoricon .iconwrap{
  width:56px;
  height:56px;
  flex-basis:56px;
  border-radius:14px;
}
.sensorcontent{
  padding:15px 15px 15px 7px;
}
.sensor .label{
  font-size:11px;
  margin-bottom:5px;
}
.sensor .value,
.sensor.emphasis .value{
  font-size:19px;
}
.sensor.compact .value{
  font-size:17px;
}
.sensor .sub{
  font-size:11px;
  margin-top:7px;
  line-height:1.3;
}

/* SD-card in dezelfde visuele familie */
.sd{
  border-radius:var(--radius-md);
  margin-top:12px;
}
.sd .sensoricon .iconwrap{
  width:52px;
  height:52px;
  border-radius:14px;
}

/* Compactere bottom navigation */
.page{
  padding-bottom:calc(100px + env(safe-area-inset-bottom));
}
.nav{
  border-radius:18px 18px 0 0;
  padding:7px 8px calc(14px + env(safe-area-inset-bottom));
  min-height:78px;
  gap:4px;
}
.nav button{
  min-height:48px;
  padding:4px 0;
  border-radius:14px;
  position:relative;
}
.nav button span{
  font-size:0;
}
.navIconWrap,
.nav button>span{
  width:38px;
  height:38px;
  display:flex;
  align-items:center;
  justify-content:center;
  border-radius:12px;
  transition:background .2s ease,color .2s ease,transform .18s ease;
}
.navSvgIcon,
.nav .playIconSvg{
  width:25px;
  height:25px;
}
.nav button .chartNavIcon{
  width:38px;
  height:38px;
  gap:3px;
  align-items:flex-end;
  padding:7px 8px;
}
.nav button .chartNavIcon i{
  width:5px;
}
.nav button.selected>span{
  background:rgba(252,176,49,.14);
}
.nav button.selected{
  color:var(--orange);
}
.nav button:active>span{
  transform:scale(.94);
}

/* iets meer witruimte onder de laatste dashboardcards */
#home .content{
  padding-bottom:24px;
}

/* Alle iconen op mobiel beter in verhouding */
@media(max-width:430px){
  .top{
    min-height:62px;
    padding:calc(env(safe-area-inset-top) + 9px) 14px 9px;
  }
  .brand{font-size:20px}
  .topGearBtn{width:38px;height:38px}
  .topGearIcon{width:23px;height:23px}

  .hero{
    height:132px;
    padding:18px 16px;
  }
  .hero h1{font-size:22px}
  .hero p{font-size:14px;margin-top:10px}

  .system{
    left:12px;
    right:12px;
    padding:8px 10px;
    font-size:10px;
  }

  .content{padding:12px}
  .homeactions{gap:10px}
  .action{
    min-height:112px;
    padding:13px 8px;
    border-radius:18px;
  }
  .action .bigicon{
    width:42px;
    height:42px;
  }
  .action .bigicon svg{
    width:25px;
    height:25px;
  }

  .sensor{
    min-height:126px;
  }
  .sensor.compact{
    min-height:116px;
  }
  .sensoricon .iconwrap{
    width:52px;
    height:52px;
    flex-basis:52px;
  }
  .sensorcontent{
    padding:13px 12px 13px 6px;
  }
  .sensor .value,
  .sensor.emphasis .value{
    font-size:18px;
  }
  .sensor.compact .value{
    font-size:16px;
  }

  .nav{
    min-height:70px;
    padding:6px 8px calc(10px + env(safe-area-inset-bottom));
  }
  .nav button{
    min-height:46px;
  }
  .navIconWrap,
  .nav button>span{
    width:36px;
    height:36px;
  }
  .navSvgIcon,
  .nav .playIconSvg{
    width:24px;
    height:24px;
  }
  .nav button .chartNavIcon{
    width:36px;
    height:36px;
  }
}

/* Op zeer smalle telefoons blijven sensorcards 2 naast elkaar, maar compacter */
@media(max-width:380px){
  #home .sensors{
    grid-template-columns:1fr 1fr;
    gap:9px;
  }
  #home .sensor{
    min-height:118px;
    grid-template-columns:29% 71%;
  }
  #home .sensoricon{
    padding:10px 5px;
  }
  #home .sensoricon .iconwrap{
    width:44px;
    height:44px;
    flex-basis:44px;
  }
  #home .sensorcontent{
    padding:10px 8px 10px 4px;
  }
  #home .sensor .label{
    font-size:10px;
  }
  #home .sensor .value,
  #home .sensor.emphasis .value{
    font-size:16px;
  }
  #home .sensor.compact .value{
    font-size:15px;
  }
  #home .sensor .sub{
    font-size:9.5px;
  }
}

/* ===== Compacte sticky topbar + kleinere onderruimte ===== */

/* Kleur de iOS safe-area bovenaan hetzelfde als de header */
html{
  background:var(--navy);
}
body{
  background:var(--bg);
}
body::before{
  content:"";
  position:fixed;
  top:0;
  left:0;
  right:0;
  height:env(safe-area-inset-top);
  background:var(--navy);
  z-index:49;
  pointer-events:none;
}

/* Header blijft zichtbaar tijdens scrollen */
.top{
  position:sticky;
  top:0;
  z-index:50;
  min-height:56px;
  padding:calc(env(safe-area-inset-top) + 6px) 14px 7px;
  box-shadow:0 2px 8px rgba(0,0,0,.08);
}
.brand{
  font-size:20px;
  line-height:1;
}
.topGearBtn{
  width:36px;
  height:36px;
}
.topGearIcon{
  width:22px;
  height:22px;
}

/* Minder ruimte onderaan de app */
.page{
  padding-bottom:calc(76px + env(safe-area-inset-bottom));
}
.nav{
  min-height:62px;
  padding:4px 8px calc(5px + env(safe-area-inset-bottom));
}
.nav button{
  min-height:42px;
  padding:2px 0;
}
.navIconWrap,
.nav button>span{
  width:34px;
  height:34px;
}
.navSvgIcon,
.nav .playIconSvg{
  width:23px;
  height:23px;
}
.nav button .chartNavIcon{
  width:34px;
  height:34px;
  padding:6px 7px;
}

/* De laatste content hoeft niet zo ver boven de navigatie te stoppen */
#home .content{
  padding-bottom:14px;
}

/* Mobiel nog compacter */
@media(max-width:430px){
  .top{
    min-height:54px;
    padding:calc(env(safe-area-inset-top) + 5px) 12px 6px;
  }
  .brand{font-size:19px}
  .topGearBtn{width:34px;height:34px}
  .topGearIcon{width:21px;height:21px}

  .page{
    padding-bottom:calc(70px + env(safe-area-inset-bottom));
  }
  .nav{
    min-height:58px;
    padding:3px 8px calc(4px + env(safe-area-inset-bottom));
  }
  .nav button{
    min-height:40px;
  }
  .navIconWrap,
  .nav button>span{
    width:32px;
    height:32px;
  }
  .navSvgIcon,
  .nav .playIconSvg{
    width:22px;
    height:22px;
  }
  .nav button .chartNavIcon{
    width:32px;
    height:32px;
  }
}

/* ===== Iets grotere topbar en menu-iconen ===== */
.top{
  min-height:64px;
  padding:calc(env(safe-area-inset-top) + 8px) 16px 9px;
}
.brand{
  font-size:22px;
}
.topGearBtn{
  width:42px;
  height:42px;
}
.topGearIcon{
  width:25px;
