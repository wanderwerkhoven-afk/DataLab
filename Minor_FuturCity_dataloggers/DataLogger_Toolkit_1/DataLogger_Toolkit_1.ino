}
.navSvgIcon,
.nav .playIconSvg{
  width:28px;
  height:28px;
}
.nav button .chartNavIcon{
  width:40px;
  height:40px;
  padding:6px 7px;
}
.nav button .chartNavIcon i{
  width:5.5px;
}

