/* Meetpagina: consistente binnenmarges en uitlijning van sensortegels */
.measuregrid{gap:12px;grid-template-columns:repeat(2,minmax(0,1fr))}
.measuregrid .tile{padding:18px 16px;min-height:116px;gap:13px;align-items:center;min-width:0}
.measuregrid .tile .symbol{flex:0 0 29px;width:29px;text-align:center;font-size:25px;line-height:1}
.measuregrid .tile>div{flex:1;min-width:0}
.measuregrid .tile .label{font-size:15px;line-height:1.35;margin-bottom:7px}
.measuregrid .tile .value{font-size:20px;line-height:1.22;margin:0 0 8px;overflow-wrap:break-word}
.measuregrid .tile .sub{font-size:14px;line-height:1.35;margin:0}
@media(max-width:370px){.measuregrid{gap:9px}.measuregrid .tile{padding:15px 11px;gap:8px}.measuregrid .tile .symbol{flex-basis:23px;width:23px;font-size:22px}.measuregrid .tile .label{font-size:14px}.measuregrid .tile .value{font-size:18px}.measuregrid .tile .sub{font-size:13px}}

/* DataLogger: twee volledig werkende, opgeslagen thema's. */
:root {color-scheme:light;--bg:#E9E9E9;--ink:#232323;--muted:#526075;--navy:#343F58;--orange:#FCB031;--surface:#FFFFFF;--surface-alt:#F1F3F6;--border:#DCE2EB;--shadow:rgba(35,35,35,.09);--button-text:#FFFFFF}
:root[data-theme="dark"] {color-scheme:dark;--bg:#232323;--ink:#FFFFFF;--muted:#C0CAD8;--navy:#343F58;--orange:#FCB031;--surface:#30394B;--surface-alt:#283246;--border:#4B5870;--shadow:rgba(0,0,0,.22);--button-text:#FFFFFF}
body,.app{background:var(--bg);color:var(--ink)}
.content,.sheet,.panel,.sensor,.tile,.sd,.modal{background:var(--surface);color:var(--ink)}
.sensor,.tile,.sd,.location,.option{border-color:var(--border);box-shadow:0 2px 8px var(--shadow)}
.settingrow,.hint,.state,.option{background:var(--surface-alt);color:var(--ink)}
.settingrow button{background:var(--border);color:var(--ink)}
.label,.option small,.locationaside small,.meta,.sub,.settingrow small{color:var(--muted)}
.file,.modal section{border-color:var(--border)}
#settings .panel button[onclick="openModal('about')"]{background:var(--surface)!important;color:var(--ink);border:1px solid var(--border);border-radius:11px}
.action.start,.startbtn,.pause{background:var(--orange);color:#232323}
.action.data,.continue,.file button{background:var(--navy);color:#FFFFFF}
.stop{background:var(--red);color:#FFFFFF}
.hero{background:linear-gradient(130deg,#253044 20%,#657a90 65%,#f3d2b6);color:#FFFFFF}
.system{background:var(--surface);color:var(--ink)}
.nav,.top{background:var(--navy);color:#FFFFFF}
.nav button{color:#E9E9E9}.nav button.selected{color:var(--orange)}
:root[data-theme="dark"] .pill{background:#214C3A;color:#A5E6C0}
:root[data-theme="dark"] .locationaside p{color:#87BEFF}
:root[data-theme="dark"] .map{background:linear-gradient(140deg,#244B3C 0%,#304B42 45%,#224457 46%,#31546A 70%,#305041 71%)}
:root[data-theme="dark"] .option.selected{background:#554526;border-color:var(--orange)}
:root[data-theme="dark"] .sd .arrow{color:var(--muted)}
:root[data-theme="dark"] #badge{color:#232323}
@media(prefers-reduced-motion:reduce){*,*:before,*:after{scroll-behavior:auto!important;transition:none!important;animation:none!important}}

/* Mobile-first interval sheet */
.modal:has(#intervalChoices){width:min(100%,520px);padding:clamp(20px,5vw,30px);border-radius:24px;max-height:calc(100dvh - 32px);overflow-y:auto}
.interval-intro{color:var(--muted);line-height:1.5;margin:0 0 19px}
.interval-choices{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px;margin:16px 0 21px}
.interval-choice{background:var(--surface-alt);border:2px solid var(--border);border-radius:15px;min-height:80px;padding:10px 5px;color:var(--ink);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:5px;font-weight:800;font-size:20px;transition:border-color .12s,background .12s}
.interval-choice small{font-size:12px;font-weight:500;color:var(--muted)}
.interval-choice[aria-pressed="true"]{border-color:var(--orange);background:color-mix(in srgb,var(--orange) 13%,var(--surface));box-shadow:inset 0 0 0 1px var(--orange)}
.interval-help{border-radius:12px;background:var(--surface-alt);padding:13px 15px;color:var(--muted);line-height:1.45;font-size:13px;margin-bottom:20px}
.interval-save{width:100%;min-height:56px;font-weight:800;font-size:16px;border-radius:14px}
@media(max-width:360px){.interval-choices{gap:7px}.interval-choice{min-height:72px;font-size:20px}}
/* Custom interval selection */
.interval-custom{display:flex;align-items:center;gap:12px;border:2px solid var(--border);border-radius:15px;padding:14px 16px;background:var(--surface-alt);margin:-5px 0 15px;min-height:76px}
.interval-custom:focus-within,.interval-custom.selected{border-color:var(--orange);box-shadow:inset 0 0 0 1px var(--orange)}
.interval-custom label{flex:1;font-weight:700;color:var(--ink);line-height:1.35}
.interval-custom label small{display:block;color:var(--muted);font-size:12px;font-weight:400;margin-top:4px}
.interval-custom input{width:92px;min-width:0;min-height:48px;border:1px solid var(--border);border-radius:10px;background:var(--surface);color:var(--ink);text-align:center;font-size:22px;font-weight:800;padding:8px}
.interval-error{color:#dc2626;min-height:18px;font-size:13px;margin:0 0 10px}
@media(max-width:360px){.interval-custom{padding:11px;gap:8px}.interval-custom input{width:78px}}

/* Meetpagina iconen: één kleur, licht/donker thema */
:root{--measure-icon:#253044}
:root[data-theme="dark"]{--measure-icon:#FFFFFF}
.measuregrid .tile .symbol{color:var(--measure-icon)!important}
.measuregrid .tile .symbol svg *{stroke:currentColor!important;fill:none!important}
.measuregrid .tile .symbol svg circle,.measuregrid .tile .symbol svg .fill-icon{fill:currentColor!important;stroke:none!important}

/* Meetpagina: zelfde 1/3 icoon + 2/3 content styling als dashboard, zonder dashboard te wijzigen */
.measuregrid{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.measuregrid .tile{position:relative;border:1px solid var(--border);border-radius:18px;padding:0;background:var(--surface);box-shadow:0 8px 20px var(--shadow);display:grid;grid-template-columns:32% 68%;align-items:stretch;min-height:132px;overflow:hidden}
.measuregrid .tile .tileicon{display:flex;align-items:center;justify-content:center;padding:18px}
.measuregrid .tile .tileicon .iconwrap{width:58px;height:58px;flex:0 0 58px;border-radius:16px;background:rgba(37,48,68,.05);display:flex;align-items:center;justify-content:center}
:root[data-theme="dark"] .measuregrid .tile .tileicon .iconwrap{background:rgba(255,255,255,.06)}
.measuregrid .tile .tilecontent{display:flex;flex-direction:column;justify-content:center;padding:18px 16px 18px 6px;min-width:0}
.measuregrid .tile .label{font-size:12px;margin-bottom:6px}
.measuregrid .tile .value{font-size:17px;font-weight:800;line-height:1.15;margin:0 0 8px;overflow-wrap:anywhere}
.measuregrid .tile .sub{font-size:14px;line-height:1.35;margin:0}
.measuregrid .tile .symbol{display:flex;align-items:center;justify-content:center}
.measuregrid .tile .symbol svg{width:30px;height:30px}
@media(max-width:380px){.measuregrid{grid-template-columns:1fr}.measuregrid .tile{min-height:118px}}

/* Grafiekenpagina */
.chartwrap{padding:17px}.chartwrap h1{font-size:23px;margin:0 0 5px}.chartintro{font-size:13px;color:var(--muted);margin:0 0 16px}.chartpanel{background:var(--surface);border:1px solid var(--border);border-radius:17px;padding:16px;margin-bottom:13px;box-shadow:0 5px 16px var(--shadow)}
.chartlabel{display:block;font-size:12px;color:var(--muted);margin-bottom:8px}.chartselect{width:100%;border:1px solid var(--border);background:var(--surface-alt);color:var(--ink);border-radius:12px;padding:13px 14px;font-weight:700;min-height:48px}.metricbuttons{display:grid;grid-template-columns:1fr 1fr;gap:8px}.metricbuttons button{min-height:46px;border-radius:11px;background:var(--surface-alt);color:var(--ink);border:1px solid var(--border);font-weight:700}.metricbuttons button.active{background:var(--orange);border-color:var(--orange);color:#232323}.charthead{display:flex;align-items:flex-start;justify-content:space-between;gap:12px;margin-bottom:10px}.charthead h2{margin:0;font-size:17px}.chartvalue{text-align:right}.chartvalue strong{display:block;font-size:23px;line-height:1}.chartvalue small{color:var(--muted);font-size:11px}.chartbox{position:relative;height:265px;border-radius:13px;background:var(--surface-alt);overflow:hidden;border:1px solid var(--border);display:grid;grid-template-columns:48px 1fr}.chartyaxis{position:relative;z-index:2;background:var(--surface-alt);border-right:1px solid var(--border);overflow:hidden}.chartyaxis svg{width:48px;height:100%;display:block}.chartscroll{min-width:0;overflow-x:auto;overflow-y:hidden;-webkit-overflow-scrolling:touch;touch-action:pan-x}.chartscroll svg{height:100%;display:block;max-width:none}.chartscroll::-webkit-scrollbar{height:5px}.chartscroll::-webkit-scrollbar-thumb{background:var(--border);border-radius:999px}.chart-empty{height:245px;display:flex;align-items:center;justify-content:center;text-align:center;color:var(--muted);font-size:13px;padding:30px}.chartgridline{stroke:var(--border);stroke-width:1}.chartline{fill:none;stroke:var(--orange);stroke-width:3;stroke-linecap:round;stroke-linejoin:round}.chartarea{fill:var(--orange);opacity:.10}.chartdot{fill:var(--orange);stroke:var(--surface);stroke-width:2}.chartaxis{fill:var(--muted);font-size:10px}.chartstats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:12px}.chartstat{background:var(--surface-alt);border-radius:11px;padding:10px;text-align:center}.chartstat small{display:block;color:var(--muted);font-size:10px;margin-bottom:4px}.chartstat strong{font-size:14px}.chartnote{font-size:11px;color:var(--muted);line-height:1.45;margin-top:10px}
.manualdoc{font-size:13px;line-height:1.55;color:var(--ink)}
.manualdoc .manualhero{background:var(--navy);color:#fff;border-radius:14px;padding:16px;margin-bottom:14px}
.manualdoc .manualhero b{display:block;font-size:18px;margin-bottom:4px}.manualdoc .manualhero small{color:#dbe2ef}
.manualdoc h3{font-size:15px;margin:18px 0 6px}.manualdoc p{margin:6px 0 10px;color:var(--muted)}
.manualdoc .manualgrid{display:grid;grid-template-columns:1fr 1fr;gap:8px}.manualdoc .manualcard{background:var(--surface-alt);border:1px solid var(--border);border-radius:11px;padding:10px}
.manualdoc .manualcard b{display:block;margin-bottom:3px}.manualdoc .manualcard small{color:var(--muted);line-height:1.4}
.manualdoc .manualtable{width:100%;border-collapse:collapse;margin:8px 0}.manualdoc .manualtable td,.manualdoc .manualtable th{padding:8px;border-bottom:1px solid var(--border);text-align:left;font-size:12px}
.manualdoc .manualcallout{background:color-mix(in srgb,var(--orange) 14%,var(--surface));border-left:4px solid var(--orange);padding:10px 11px;border-radius:9px;margin:10px 0}
.manualdoc .manualsteps{display:grid;gap:7px}.manualdoc .manualstep{display:flex;gap:9px;background:var(--surface-alt);border-radius:10px;padding:9px}.manualdoc .manualnum{flex:0 0 24px;height:24px;border-radius:7px;background:var(--orange);display:grid;place-items:center;font-weight:800;color:#232323}
.manualactions{display:grid;grid-template-columns:1fr;gap:8px;margin-top:16px}.manualactions button{min-height:44px;border-radius:12px;font-weight:800}.manualpdf{background:var(--orange);color:#232323}.manualclose{background:var(--surface-alt);color:var(--ink);border:1px solid var(--border)}
@media(max-width:430px){.manualdoc .manualgrid{grid-template-columns:1fr}}
.nav .chartNavIcon{font-size:33px;font-weight:700;letter-spacing:-2px}

@media (prefers-reduced-motion:reduce){.themeswitch::before,.themeswitch button,.themeglyph{transition:none!important}}

/* Data page theme repair — layout untouched */
#data .overviewcard,#data .sessionlist,#data .filterpanel{background:var(--surface);border-color:var(--border);color:var(--ink)}
#data .sessionrow{border-color:var(--border)}
#data .periodpill,#data .searchbox,#data .filterbtn,#data .filteroption,#data .fileicon{background:var(--surface-alt);border-color:var(--border);color:var(--ink)}
#data .searchbox input{color:var(--ink)}
#data .searchbox input::placeholder{color:var(--muted);opacity:1}
#data .overviewvalue,#data .sectionhead,#data .sessiontitle,#data .filterlabel{color:var(--ink)}
#data .overviewlabel,#data .sessionmeta,#data .sessionsub,#data .periodpill{color:var(--muted)}
#data .miniicon,#data .fileicon{color:var(--ink)}
#data .filterbtn.active,#data .filteroption.active{border-color:var(--orange);background:color-mix(in srgb,var(--orange) 18%,var(--surface));color:var(--ink)}
#data .csvbtn{background:var(--orange);color:#232323}
:root[data-theme="dark"] #data .overviewcard,:root[data-theme="dark"] #data .sessionlist,:root[data-theme="dark"] #data .filterpanel{box-shadow:0 2px 10px rgba(0,0,0,.18)}


/* Mobile responsiveness improvements */
@media (max-width: 430px){
  .app{max-width:100%;}
  .top{padding:calc(env(safe-area-inset-top) + 12px) 14px 12px;min-height:64px}
  .brand{font-size:21px}
  .top button{font-size:24px;padding:2px 5px}
  .datawrap{padding:14px 12px calc(128px + env(safe-area-inset-bottom))}
  .datatop{align-items:center;margin-bottom:12px}
  .datatop h1{font-size:17px}
  .periodpill{padding:8px 10px;font-size:11px;border-radius:10px}
  .overviewgrid{grid-template-columns:1fr 1fr;gap:10px;margin-bottom:18px}
  .overviewcard{padding:12px;min-height:104px}
  .overviewcard:nth-child(3){grid-column:1 / -1;display:grid;grid-template-columns:auto 1fr;column-gap:10px;align-items:center;min-height:82px}
  .overviewcard:nth-child(3) .overviewiconrow{grid-row:1 / span 2;margin:0}
  .overviewcard:nth-child(3) .overviewvalue{align-self:end;margin:0}
  .overviewcard:nth-child(3) .overviewlabel{align-self:start}
  .overviewvalue{font-size:25px}
  .overviewlabel{font-size:11px}
  .sectionhead{font-size:17px;margin-bottom:10px}
  .filetoolbar{display:grid;grid-template-columns:1fr auto;gap:8px;margin-bottom:10px}
  .searchbox{height:42px;border-radius:11px;padding:0 11px;min-width:0}
  .searchbox input{font-size:13px}
  .filterbtn{height:42px;border-radius:11px;padding:0 12px;font-size:13px;white-space:nowrap}
  .filterpanel{margin-top:0}
  .sessionlist{border-radius:15px}
  .sessionrow{grid-template-columns:36px minmax(0,1fr) auto;gap:10px;padding:14px 12px;align-items:center}
  .fileicon{width:36px;height:36px;border-radius:10px}
  .fileicon svg{width:19px;height:19px}
  .sessiontitle{font-size:13px;margin-bottom:4px;white-space:normal;overflow-wrap:anywhere}
  .sessionmeta,.sessionsub{font-size:11px;line-height:1.4}
  .csvbtn{height:34px;padding:0 10px;font-size:11px;border-radius:9px;gap:5px}
  .csvbtn svg{width:13px;height:13px}
  .nav{width:100%;border-radius:14px 14px 0 0;padding:8px 0 calc(22px + env(safe-area-inset-bottom))}
  .nav button{min-height:52px;padding:4px 0}
  .nav button span{font-size:29px}
  .nav button .homeNavIcon{font-size:34px}
  .nav button .chartNavIcon{height:28px;width:32px}
}
@media (max-width: 360px){
  .overviewgrid{grid-template-columns:1fr;}
  .overviewcard:nth-child(3){grid-column:auto;display:block;min-height:96px}
  .overviewcard:nth-child(3) .overviewiconrow{margin-bottom:7px}
  .filetoolbar{grid-template-columns:1fr}
  .filterbtn{width:100%;justify-content:center}
  .sessionrow{grid-template-columns:32px minmax(0,1fr);}
  .fileicon{width:32px;height:32px}
  .csvbtn{grid-column:2;justify-self:start;margin-top:7px}
}

/* FINAL mobile override: keep all three overview tiles in one row */
@media (max-width:520px){
  #data .overviewgrid{
    display:grid!important;
    grid-template-columns:repeat(3,minmax(0,1fr))!important;
    gap:7px!important;
  }
  #data .overviewcard,
  #data .overviewcard:nth-child(3){
    grid-column:auto!important;
    display:block!important;
    min-width:0!important;
    min-height:88px!important;
    padding:9px 7px!important;
  }
  #data .overviewcard:nth-child(3) .overviewiconrow{
    grid-row:auto!important;
    margin-bottom:5px!important;
  }
  #data .overviewiconrow{
    min-height:14px!important;
    margin-bottom:5px!important;
  }
  #data .miniicon,#data .miniicon svg{width:14px!important;height:14px!important;}
  #data .overviewvalue{
    font-size:16px!important;
    line-height:1.05!important;
    margin-bottom:3px!important;
    white-space:normal!important;
    overflow-wrap:anywhere!important;
  }
  #data .overviewlabel{
    font-size:9.5px!important;
    line-height:1.1!important;
    white-space:normal!important;
  }
}
@media (max-width:350px){
  #data .overviewgrid{gap:5px!important;}
  #data .overviewcard,#data .overviewcard:nth-child(3){padding:8px 6px!important;min-height:84px!important;}
  #data .overviewvalue{font-size:15px!important;}
  #data .overviewlabel{font-size:9px!important;}
}

/* Verbindingshulp wanneer de Arduino niet meer bereikbaar is */
.connectionlost{position:fixed;inset:0;z-index:100;background:var(--bg);color:var(--ink);display:none;overflow:auto;padding:calc(env(safe-area-inset-top) + 20px) 16px calc(env(safe-area-inset-bottom) + 28px)}
.connectionlost.show{display:block}
.connectionlost-inner{width:min(100%,520px);margin:0 auto}
.connectionlost-brand{font-size:22px;font-weight:800;color:var(--ink);margin-bottom:34px}.connectionlost-brand span{color:var(--orange)}
.connectionlost-icon{width:72px;height:72px;border-radius:22px;background:var(--surface);border:1px solid var(--border);display:flex;align-items:center;justify-content:center;margin:0 0 20px;box-shadow:0 8px 24px var(--shadow);color:var(--navy)}
.connectionlost-icon svg{width:38px;height:38px}
.connectionlost h1{font-size:25px;line-height:1.18;margin:0 0 12px}
.connectionlost>div p,.connectionlost-inner>p{color:var(--muted);font-size:14px;line-height:1.55;margin:0 0 20px}
.connectionchecklist{display:grid;gap:10px;margin:20px 0}
.connectioncheck{display:grid;grid-template-columns:38px 1fr;gap:12px;align-items:start;background:var(--surface);border:1px solid var(--border);border-radius:16px;padding:14px;box-shadow:0 3px 12px var(--shadow)}
.connectioncheck-num{width:38px;height:38px;border-radius:12px;background:var(--surface-alt);display:flex;align-items:center;justify-content:center;font-weight:800;color:var(--navy)}
.connectioncheck b{display:block;font-size:14px;margin:1px 0 4px}.connectioncheck small{display:block;color:var(--muted);font-size:12px;line-height:1.45}
.connectionwifi{background:color-mix(in srgb,var(--orange) 13%,var(--surface));border:1px solid color-mix(in srgb,var(--orange) 48%,var(--border));border-radius:14px;padding:13px 14px;margin:14px 0;font-size:13px;line-height:1.5}
.connectionwifi code{font-family:inherit;font-weight:800;color:var(--ink)}
.connectionactions{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:18px}
.connectionactions button{min-height:52px;border-radius:13px;font-weight:800;padding:0 12px}
.connectionretry{background:var(--orange);color:#232323}.connectionreload{background:var(--surface-alt);color:var(--ink);border:1px solid var(--border)}
.connectionstate{font-size:12px;color:var(--muted);text-align:center;margin-top:12px;min-height:18px}
@media(max-width:360px){.connectionactions{grid-template-columns:1fr}.connectionlost h1{font-size:23px}}

/* ===== Dashboard UI polish ===== */
:root{
  --radius-sm:12px;
  --radius-md:16px;
  --radius-lg:20px;
}

/* Compactere app-header */
.top{
  min-height:68px;
  padding:calc(env(safe-area-inset-top) + 12px) 16px 12px;
}
.brand{font-size:22px}
.topGearBtn{
  width:42px;
  height:42px;
  padding:0!important;
  border-radius:12px;
  display:flex;
  align-items:center;
  justify-content:center;
}
.topGearIcon{width:25px;height:25px;display:block}

/* Minder hoge hero zodat de primaire acties sneller zichtbaar zijn */
.hero{
  height:148px;
  padding:20px 18px;
}
.hero h1{
  font-size:23px;
  line-height:1.1;
}
.hero p{
  margin-top:12px;
  font-size:15px;
}
.hero:after{
  height:64px;
  bottom:18px;
}

/* Compactere systeemstatus */
.system{
  left:14px;
  right:14px;
  padding:9px 12px;
  border-radius:14px 14px 0 0;
  font-size:11px;
  align-items:center;
}
.system .dot{
  width:8px;
  height:8px;
  margin-right:6px;
}

/* Meer balans in primaire dashboardtiles */
.content{
  padding:14px;
}
.homeactions{
  gap:12px;
}
.action{
  min-height:122px;
  border-radius:var(--radius-lg);
  padding:15px 10px;
  gap:9px;
}
.action strong{
  font-size:15px;
  line-height:1.2;
}
.action small{
  font-size:11px;
  line-height:1.35;
  opacity:.9;
}
.action .bigicon{
  width:46px;
  height:46px;
}
.action .bigicon svg{
  width:27px;
  height:27px;
}
.playIconWrap,
.dataIconWrap{
  border-radius:14px;
  display:flex;
  align-items:center;
  justify-content:center;
}
.playIconWrap{
  background:rgba(35,35,35,.14);
  color:#232323;
}
.dataIconWrap{
  background:rgba(255,255,255,.12);
  color:#fff;
}
.actionDataIcon{display:block}

/* Rustigere sectiekop */
.sectiontitle{
  margin:20px 3px 12px;
}
.sectiontitle h2{
  font-size:18px;
}
.live{
  font-size:12px;
}
.live .dot{
  width:8px;
  height:8px;
}

/* Sensorcards: meer ruimte voor de meetwaarde */
.sensors{
  gap:12px;
}
.sensor{
  grid-template-columns:28% 72%;
  min-height:134px;
  border-radius:var(--radius-md);
}
.sensor.compact{
  min-height:124px;
}
.sensoricon{
  padding:14px 10px;
}
.sensoricon .iconwrap{
  width:56px;
  height:56px;
  flex-basis:56px;
  border-radius:14px;
}
.sensorcontent{
  padding:15px 15px 15px 7px;
}
.sensor .label{
  font-size:11px;
  margin-bottom:5px;
}
.sensor .value,
.sensor.emphasis .value{
  font-size:19px;
}
.sensor.compact .value{
  font-size:17px;
}
.sensor .sub{
  font-size:11px;
  margin-top:7px;
  line-height:1.3;
}

/* SD-card in dezelfde visuele familie */
.sd{
  border-radius:var(--radius-md);
  margin-top:12px;
}
.sd .sensoricon .iconwrap{
  width:52px;
  height:52px;
  border-radius:14px;
}

/* Compactere bottom navigation */
.page{
  padding-bottom:calc(100px + env(safe-area-inset-bottom));
}
.nav{
